rules_version = '2';

// Cloud Storage for attendee credential images.
//
// Storage was not configured on this project before this feature: there was
// no storage.rules file and no "storage" key in firebase.json, only an
// inert storageBucket in the client config. This file is therefore the
// whole policy, and it starts closed.
service firebase.storage {
  match /b/{bucket}/o {
    // Reading the role from Firestore is what lets the moderation panel
    // render an image with getDownloadURL() instead of needing a
    // signed-URL endpoint in the API.
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function staffPath(eventSlug) {
      return /databases/(default)/documents/events/$(eventSlug)/staff/$(request.auth.uid);
    }

    // Una asignación sin `expiresAt` no caduca; una con fecha pasada deja de
    // conceder sola, sin que nadie tenga que acordarse de borrarla.
    //
    // Comprobarlo aquí no es un detalle: esta función es la única diferencia
    // entre "el voluntario del evento" y "quien lo fue alguna vez". Sin ella
    // esto solo miraba que el documento EXISTIERA, así que una asignación
    // caducada seguía sirviendo fotos y DNI de un evento que esa persona ya
    // no trabaja — mientras Firestore ya le negaba el documento con esos
    // mismos datos. Ver `isEventStaff()` en firestore.rules, que es de donde
    // sale esta regla.
    // Un solo `get()` en vez de `exists()` + `get()`: un documento ausente
    // vuelve como null, y atarlo a un local deja esto en un acceso. Es el
    // mismo cuerpo que `isEventStaff()`, que es lo que un espejo tiene que
    // ser — y en una carga del panel de moderación esto corre una vez por
    // cada imagen, así que la diferencia es factura, no microoptimización.
    function staffAssignmentActive(eventSlug) {
      let staff = firestore.get(staffPath(eventSlug));
      return staff != null
             && (staff.data.get('expiresAt', null) == null
                 || staff.data.get('expiresAt', null) > request.time);
    }

    // Espejo de `canOnEvent('roster:read', …)` en firestore.rules: estas
    // imágenes son la misma clase de dato personal que el roster, así que
    // se rigen igual. Un voluntario solo ve las del evento que tiene
    // asignado y mientras dure la asignación; organizadores y admins, todas.
    //
    // exists() antes que get(): quien tiene sesión pero ningún doc en
    // users/{uid} hace que get() devuelva null, y leer .role de null revienta
    // la evaluación. La petición acabaría denegada igual, pero por reventar la
    // regla en vez de por evaluarla — lo que llena los logs de ruido y taparía
    // una mala configuración de verdad.
    function canReadCredentials(eventSlug) {
      return request.auth != null
        && firestore.exists(userPath())
        && callerCanRead(firestore.get(userPath()).data, eventSlug);
    }

    // El doc de quien llama se lee UNA vez y se pasa aquí. Antes cada
    // comprobación hacía su propio firestore.get(), y son lecturas facturadas
    // por cada objeto que el panel de moderación pinta.
    //
    // Mismo orden que `canOnEventWith` en firestore.rules, y por las mismas
    // razones:
    //   - La suspensión es la palanca de emergencia: corta todo de golpe sin
    //     deshacer rol y permisos uno a uno.
    //   - Las revocaciones restan sobre lo que concede el rol, y la API las
    //     aplica en cada petición. Sin mirarlas aquí, revocar `roster:read`
    //     quitaba la mitad del panel que pasa por la API y dejaba intacta la
    //     descarga directa de las imágenes, que es el dato más sensible.
    //
    // Los `grants` NO se evalúan, ni aquí ni en firestore.rules: el lenguaje
    // de reglas no sabe recorrer una lista de mapas, así que un grant con
    // caducidad no es expresable. Conceder acceso a un evento concreto se hace
    // con la asignación de staff, que es justo para lo que existe.
    function callerCanRead(caller, eventSlug) {
      return caller.get('status', 'active') != 'suspended'
        && !('roster:read' in caller.get('revocations', []))
        && (
          caller.get('role', '') in ['organizer', 'admin']
          || (caller.get('role', '') == 'volunteer'
              && staffAssignmentActive(eventSlug))
        );
    }

    // credentials/{eventSlug}/{credentialId}/photo.jpg
    // credentials/{eventSlug}/{credentialId}/credential.jpg
    match /credentials/{eventSlug}/{credentialId}/{fileName} {
      allow read: if canReadCredentials(eventSlug);

      // Written EXCLUSIVELY by the Admin SDK, which bypasses these rules.
      // Images arrive as base64 in the request body and the Cloud Function
      // is the only thing that puts bytes in this bucket, so no anonymous
      // principal ever holds a write grant. Direct client upload was
      // considered and rejected: it would need a reservation collection for
      // these rules to check against, an abandoned-object sweep, and a real
      // write grant for anonymous users — all to save a round trip the
      // client spends downscaling for the canvas anyway.
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
