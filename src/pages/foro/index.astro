---
import CallToActionSection from "@/components/CallToActionSection.astro";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import NButton from "@/components/night/NButton.astro";
import PageHeader from "@/components/night/PageHeader.astro";
import { getCollection } from "astro:content";
import { fetchLinks } from "@/loaders/transform-site-config";

// Más recientes primero. El loader ya dejó fuera los borradores.
//
// `publishedAt` puede faltar en un post commiteado a mano, y `Date.parse` de
// algo ilegible da NaN: un comparador que devuelve NaN deja el orden de todo
// el vecindario a merced de la implementación de sort, no solo el del post sin
// fecha. Con 0, los que no tienen fecha caen al final y de forma estable.
const time = (iso: string) => {
  const ms = Date.parse(iso || "");
  return Number.isNaN(ms) ? 0 : ms;
};

const posts = (await getCollection("posts")).sort(
  (a, b) => time(b.data.publishedAt) - time(a.data.publishedAt)
);

// La más reciente va destacada; el resto, como lista de lectura.
const [latest, ...earlier] = posts;

const links = await fetchLinks();

const metadata = {
  title: "Foro - Google Developer Group Ica",
  description:
    "Publicaciones de la comunidad GDG Ica: apuntes de los eventos, tutoriales, anuncios y lo que aprendemos construyendo con las tecnologías de Google.",
  image: "https://gdgica.com/gdg-logo.png",
  url: "https://gdgica.com/foro/",
};
---

<Layout {...metadata}>
  <main>
    <PageHeader
      title="Foro"
      label="Apuntes, tutoriales y anuncios"
      lead="Apuntes de nuestros eventos, tutoriales, anuncios y lo que vamos aprendiendo. Lo escribe el equipo organizador del GDG Ica."
    />

    <section class="forum" aria-label="Publicaciones">
      <div class="n-container">
        {
          latest ? (
            <>
              <PostCard
                slug={latest.id}
                {...latest.data}
                variant="featured"
                level={2}
                eager
              />

              {earlier.length > 0 && (
                <div class="forum__earlier">
                  <div class="n-section-head">
                    <h2 class="n-head">Publicaciones anteriores</h2>
                    <span class="n-mono forum__count">
                      {earlier.length}{" "}
                      {earlier.length === 1 ? "publicación" : "publicaciones"}
                    </span>
                  </div>
                  <ol class="forum__list">
                    {earlier.map((post) => (
                      <li>
                        <PostCard slug={post.id} {...post.data} />
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </>
          ) : (
            <div class="forum__empty n-panel n-marks">
              <h2 class="n-head">Todavía no hay publicaciones</h2>
              <p class="forum__empty-copy">
                Estamos preparando las primeras. Mientras tanto, pásate por
                nuestros eventos.
              </p>
              <NButton variant="ghost" href="/events">
                Ver eventos
              </NButton>
            </div>
          )
        }
      </div>
    </section>

    <CallToActionSection>
      <h2>¿Quieres escribir en el foro?</h2>
      <p>
        Si tienes algo que contar a la comunidad —un tutorial, lo que aprendiste
        en un evento, un proyecto— escríbenos y lo publicamos.
      </p>
      <NButton href={links.forms.contact} target="_blank">Contáctanos</NButton>
    </CallToActionSection>
  </main>
</Layout>

<style>
  .forum {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .forum__earlier {
    margin-top: clamp(3.5rem, 2rem + 4vw, 6rem);
  }

  .forum__count {
    color: var(--muted);
  }

  .forum__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .forum__list > li + li {
    border-top: 1px solid var(--line);
  }

  .forum__empty {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.75rem, 1rem + 4vw, 4rem);
  }

  .forum__empty h2 {
    margin: 0;
  }

  .forum__empty-copy {
    max-width: 48ch;
    margin: 0 0 1rem;
    color: var(--muted);
  }
</style>
