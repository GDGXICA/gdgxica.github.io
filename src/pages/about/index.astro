---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/night/PageHeader.astro";
import NButton from "@/components/night/NButton.astro";
import StatsBar from "@/components/StatsBar.astro";
import CallToActionSection from "@/components/CallToActionSection.astro";
import OrganizerCard from "@/components/OrganizerCard.astro";
import { getCollection } from "astro:content";
import { fetchStats, fetchLinks } from "@/loaders/transform-site-config";
import { buildAboutSchema } from "@/utils/schema";
import { publicImageSize } from "@/utils/imageSize";

const organizersCollection = await getCollection("organizers");
const organizers = organizersCollection.map((entry) => entry.data);
// Team members are hidden for now: only organizers are listed. Set this to
// true to show the "Miembros del equipo" group again.
const SHOW_TEAM_MEMBERS = false;
const members = SHOW_TEAM_MEMBERS
  ? (await getCollection("members")).map((entry) => entry.data)
  : [];
const teamGroups = [
  { title: "Organizadores", people: organizers },
  { title: "Miembros del equipo", people: members },
].filter((group) => group.people.length > 0);
const stats = await fetchStats();
const links = await fetchLinks();

const impactStats = [
  { value: `${stats.yearsActive}`, label: "años creando comunidad" },
  { value: `${stats.totalMembers}+`, label: "miembros de la comunidad" },
  { value: `${stats.totalEvents}+`, label: "eventos realizados" },
  { value: `${stats.totalSpeakers}+`, label: "speakers participantes" },
];

// One photo of the community beside the page title: the first landscape shot in
// the gallery, shown whole at its own ratio.
const gallery = (await getCollection("gallery")).map((entry) => entry.data);
const headPhoto =
  gallery
    .map((photo) => ({ ...photo, size: publicImageSize(photo.src) }))
    .find((photo) => photo.size && photo.size.width > photo.size.height) ??
  null;

const values = [
  {
    title: "Aprender",
    text: "Acercamos conocimiento práctico mediante charlas, talleres y experiencias para todos los niveles.",
  },
  {
    title: "Conectar",
    text: "Reunimos a personas con intereses diversos para formar relaciones, proyectos y nuevas oportunidades.",
  },
  {
    title: "Impulsar",
    text: "Damos espacio a nuevas voces para que el talento tecnológico local crezca y se haga visible.",
  },
];

const metadata = {
  title: "Nosotros - Google Developer Group Ica",
  description:
    "Conoce la historia, el propósito y las personas que hacen posible Google Developer Group Ica desde 2015.",
  image: "https://gdgica.com/gdg-logo.png",
  url: "https://gdgica.com/about/",
  schema: buildAboutSchema(links.social),
};
---

<Layout {...metadata}>
  <main>
    <PageHeader
      title="Somos GDG Ica"
      label="Ica, Perú · desde 2015"
      lead="Una comunidad tecnológica abierta donde las personas de Ica se encuentran para aprender, compartir conocimiento y crear oportunidades juntas."
    >
      <NButton href={links.community}>Únete a la comunidad</NButton>
      {
        headPhoto && headPhoto.size && (
          <figure slot="aside" class="head-photo n-marks">
            <img
              src={headPhoto.src}
              alt={headPhoto.alt}
              width={headPhoto.size.width}
              height={headPhoto.size.height}
              fetchpriority="high"
            />
          </figure>
        )
      }
      <StatsBar slot="strip" stats={impactStats} />
    </PageHeader>

    <section id="historia" class="story" aria-labelledby="story-title">
      <div class="n-container story__grid">
        <h2 id="story-title" class="n-head">Tecnología con raíces en Ica</h2>
        <div class="story__body">
          <div class="story__text">
            <p>
              GDG Ica nació en 2015 como un punto de encuentro para quienes
              querían aprender sobre tecnología y compartir lo que sabían con
              otras personas de la región.
            </p>
            <p>
              Desde entonces organizamos eventos, talleres y conversaciones que
              acercan a estudiantes, profesionales, speakers y aliados. Nuestro
              propósito sigue siendo el mismo: hacer que el conocimiento circule
              y que el talento local encuentre un espacio para crecer.
            </p>
          </div>
          <!-- The span of the story, drawn as a survey dimension. -->
          <p class="story__span n-mono" aria-hidden="true">
            <span>2015</span>
            <span class="story__span-line"></span>
            <span>hoy</span>
          </p>
        </div>
      </div>
    </section>

    <section class="values" aria-labelledby="values-title">
      <div class="n-container values__grid">
        <div class="values__intro">
          <h2 id="values-title" class="n-head">
            Aprender juntos transforma la comunidad
          </h2>
          <p class="n-lead">
            Todo lo que hacemos parte de tres ideas sencillas.
          </p>
        </div>
        <ol class="values__list">
          {
            values.map((value, index) => (
              <li class="values__item">
                <span class="values__index n-mono" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="values__title">{value.title}</h3>
                <p class="values__text">{value.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      teamGroups.length > 0 && (
        <section id="equipo" class="team" aria-labelledby="team-title">
          <div class="n-container">
            <div class="team__intro">
              <h2 id="team-title" class="n-head">
                Un equipo, un mismo propósito
              </h2>
              <p class="n-lead">
                Organizamos actividades, cuidamos la comunidad y convertimos las
                ideas en experiencias donde más personas puedan aprender y
                conectar.
              </p>
            </div>

            {teamGroups.map((group) => (
              <div class="team__group">
                <h3 class="team__group-title">
                  {group.title}
                  <span class="n-mono">{group.people.length}</span>
                </h3>
                <ul class="team__roster">
                  {group.people.map((person) => (
                    <li>
                      <OrganizerCard organizer={person} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <CallToActionSection>
      <h2>Encuentra tu forma de participar</h2>
      <p>
        Asiste a nuestros eventos y comparte con la comunidad, o aporta tus
        habilidades como parte del voluntariado.
      </p>
      <div class="cta-actions">
        <NButton href={links.forms.joinCommunity}>Únete a la comunidad</NButton>
        <NButton variant="ghost" href="/volunteers">
          Conoce el voluntariado
        </NButton>
      </div>
    </CallToActionSection>
  </main>
</Layout>

<style>
  /* ---- header photo ---- */
  /* The community, framed with the survey's corner marks. */
  .head-photo {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-1);
  }

  .head-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 1px);
  }

  /* ---- story ---- */
  .story {
    padding-block: var(--section-gap);
  }

  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .story__grid h2 {
    max-width: 14ch;
    margin: 0;
  }

  .story__text {
    max-width: 54ch;
    color: var(--muted);
  }

  .story__text p {
    margin: 0;
  }

  /* The founding line leads, the rest follows at reading size. */
  .story__text p:first-child {
    color: var(--ink);
    font-size: var(--step-lead);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .story__text p + p {
    margin-top: 1.25em;
  }

  /* 2015 |———————| hoy, in the survey's ochre. */
  .story__span {
    display: flex;
    max-width: 54ch;
    align-items: center;
    gap: 0.75rem;
    margin: 2.5rem 0 0;
    color: var(--ochre);
  }

  .story__span-line {
    height: 10px;
    flex: 1;
    border-inline: 1.5px solid var(--ochre);
    background: linear-gradient(var(--ochre), var(--ochre)) center / 100% 1.5px
      no-repeat;
  }

  /* ---- values ---- */
  .values {
    padding-block: var(--section-gap);
    border-block: 1px solid var(--line);
    background: var(--surface-1);
  }

  .values__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .values__intro {
    position: sticky;
    top: 6rem;
  }

  .values__intro h2 {
    margin: 0;
  }

  .values__intro p {
    max-width: 30ch;
    margin: 1.25rem 0 0;
    color: var(--muted);
  }

  .values__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .values__item {
    display: grid;
    grid-template-columns: 3rem minmax(9rem, 0.8fr) minmax(0, 1.2fr);
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  .values__index {
    color: var(--ochre);
  }

  .values__title {
    margin: 0;
    font-size: clamp(1.75rem, 1.25rem + 1.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .values__text {
    max-width: 40ch;
    margin: 0;
    color: var(--muted);
  }

  /* ---- team ---- */
  .team {
    padding-block: var(--section-gap);
    scroll-margin-top: 4rem;
  }

  .team__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .team__intro h2 {
    margin: 0;
  }

  .team__intro p {
    max-width: 44ch;
    margin: 0;
    color: var(--muted);
  }

  .team__group + .team__group {
    margin-top: clamp(2.5rem, 1.5rem + 2.5vw, 4rem);
  }

  /* The group's name and head count, over a fine rule. */
  .team__group-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.25rem;
    font-size: var(--step-body);
    font-weight: 600;
  }

  .team__group-title .n-mono {
    color: var(--ochre);
  }

  .team__roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team__roster > li {
    border-top: 1px solid var(--line);
  }

  /* ---- closing ---- */
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 1023px) {
    .story__grid,
    .values__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .values__intro {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .team__intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .values__item {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }

    .values__text {
      grid-column: 2;
    }
  }

  @media (max-width: 480px) {
    .cta-actions :global(.nb) {
      flex: 1 1 100%;
    }
  }
</style>
