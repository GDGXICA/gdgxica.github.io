---
import { getCollection } from "astro:content";
import QRCode from "qrcode";
import Tag from "@/components/Tag.astro";
import Layout from "@/layouts/Layout.astro";
import NButton from "@/components/night/NButton.astro";
import ScheduleCard from "@/components/ScheduleCard.astro";
import TrackTabSchedule from "@/components/TrackTabSchedule.astro";
import SpeakerCard from "@/components/SpeakerCard.astro";
import {
  ArrowRight,
  ArrowUpRight,
  Calendar,
  CalendarPlus,
  Check,
  Download,
  MapPinned,
  Plus,
} from "@lucide/astro";
import SharedButton from "@/components/react/SharedButton";
import { COLIBRI_STROKE, colibriPath, colibriViewBox } from "@/lib/colibri";
import { getEventDates, googleCalendarUrl } from "@/utils/eventDates";
import { hourRange, shortVenue, surveyDate } from "@/utils/eventShort";
import { publicImageSize } from "@/utils/imageSize";
import { getGcpCreditsConfig } from "@/data/gcpCredits";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}
const { event } = Astro.props;

function buildEventSchema(data: typeof event.data, slug: string) {
  const { startISO: startDate, endISO: endDate } = getEventDates(data);

  const location = data.isVirtual
    ? {
        "@type": "VirtualLocation",
        url: `https://gdgica.com/events/${slug}`,
      }
    : {
        "@type": "Place",
        name: data.location.name,
        address: {
          "@type": "PostalAddress",
          streetAddress: data.location.direction,
          addressLocality: "Ica",
          addressCountry: "PE",
        },
      };

  const eventAttendanceMode = data.isVirtual
    ? "https://schema.org/OnlineEventAttendanceMode"
    : "https://schema.org/OfflineEventAttendanceMode";

  const schema: Record<string, unknown> = {
    "@context": "https://schema.org",
    "@type": "Event",
    name: data.name,
    description: data.shortDescription,
    startDate,
    endDate,
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode,
    location,
    url: `https://gdgica.com/events/${slug}`,
    organizer: {
      "@type": "Organization",
      name: "Google Developer Group ICA",
      url: "https://gdgica.com",
    },
  };

  if (data.image) {
    schema.image = `https://gdgica.com${data.image}`;
  }

  if (data.registerFormLink) {
    schema.offers = {
      "@type": "Offer",
      price: "0",
      priceCurrency: "PEN",
      availability: "https://schema.org/InStock",
      url: data.registerFormLink,
    };
  }

  if (data.speakers?.length > 0) {
    schema.performer = data.speakers.map((s: { name: string }) => ({
      "@type": "Person",
      name: s.name,
    }));
  }

  return schema;
}

const metadata = {
  title: `${event.data.name}`,
  description: `${event.data.shortDescription}`,
  image: event.data.image ? `https://gdgica.com${event.data.image}` : "",
  url: `https://gdgica.com/events/${event.id}`,
  schema: buildEventSchema(event.data, event.id),
};

const gcalUrl = googleCalendarUrl(event.data, event.id);
const icsUrl = `/events/${event.id}.ics`;

const schedule = event.data.schedule;
const isArraySchedule = Array.isArray(schedule);
const isTrackSchedule =
  !isArraySchedule && "trackSessions" in (schedule as object);
const hasSchedule = isArraySchedule
  ? (schedule as unknown[]).length > 0
  : isTrackSchedule
    ? Object.keys(
        (schedule as { trackSessions: Record<string, unknown[]> }).trackSessions
      ).length > 0
    : false;

type TrackSchedule = {
  trackSessions: Record<
    string,
    {
      id: number;
      title: string;
      name: string;
      image: string;
      role: string;
      type: string;
      startTime: string;
      endTime: string;
      duration: string;
      isKeynote?: boolean;
    }[]
  >;
};

// A multi-track agenda without its `tracks` list still gets one tab per
// track key, named after the key, instead of failing the build.
const tracks =
  event.data.tracks ??
  (isTrackSchedule
    ? Object.keys((schedule as TrackSchedule).trackSessions).map((id) => ({
        id,
        name: id,
        color: "var(--muted)",
        description: "",
      }))
    : []);

const isPast = event.data.status.type === "completed";
const canRegister = !isPast && Boolean(event.data.registerFormLink);

const seatsPercent =
  event.data.maxParticipants > 0
    ? Math.min(
        100,
        Math.round((event.data.participants / event.data.maxParticipants) * 100)
      )
    : null;

const whatsappGroupLink = event.data.whatsappGroupLink;
// Data URL rather than an SVG string so it goes into an <img src>, without
// injecting raw HTML into the page. Same approach as credencial.astro.
// Printed in the theme's paper and ink: a scanner needs dark on light.
const whatsappQrDataUrl = whatsappGroupLink
  ? await QRCode.toDataURL(whatsappGroupLink, {
      errorCorrectionLevel: "M",
      margin: 1,
      width: 480,
      color: { dark: "#0a1021", light: "#ecebe2" },
    })
  : null;

// ---- the head's readout -------------------------------------------------
const dates = getEventDates(event.data);
const venueShort = shortVenue(event.data.location.name, event.data.isVirtual);

/** "14.07° S · 75.74° O" from the Google Maps embed's own pin, if any. */
function coordinates(embed: string): string | null {
  const lat = Number(embed.match(/!3d(-?\d+(?:\.\d+)?)/)?.[1]);
  const lng = Number(embed.match(/!2d(-?\d+(?:\.\d+)?)/)?.[1]);
  if (!Number.isFinite(lat) || !Number.isFinite(lng) || (!lat && !lng)) {
    return null;
  }
  const fmt = (v: number, pos: string, neg: string) =>
    `${Math.abs(v).toFixed(2)}° ${v < 0 ? neg : pos}`;
  return `${fmt(lat, "N", "S")} · ${fmt(lng, "E", "O")}`;
}

const dimLabel = event.data.isVirtual
  ? "Evento en línea"
  : (coordinates(event.data.location.googleMapEmbed) ?? "Ica, Perú");

const poster = event.data.image || "/placeholder.svg";
const posterSize = publicImageSize(poster) ?? { width: 1200, height: 900 };
const longTitle = event.data.name.length > 34;

const paragraphs = event.data.largeDescription
  .split(/\n+/)
  .map((p) => p.trim())
  .filter(Boolean);

const colibri = colibriPath();
const gcpCredits = getGcpCreditsConfig(event.id);
const eventTools = [
  ...(gcpCredits
    ? [
        {
          href: `/events/${event.id}/creditos`,
          title: "Créditos de Google Cloud",
          note: `Canjea tu cupón · ${gcpCredits.creditsPeriodLabel}`,
          until: gcpCredits.viewClosesAt,
        },
      ]
    : []),
  ...(event.data.credential?.enabled
    ? [
        {
          href: `/events/${event.id}/credencial`,
          title: "Crea tu credencial",
          note: "Tarjeta personalizada del evento",
        },
      ]
    : []),
  ...(event.data.mural?.enabled
    ? [
        {
          href: `/events/${event.id}/fotos`,
          title: "Fotos de la comunidad",
          note: "Mural de fotos de los asistentes",
        },
      ]
    : []),
];
const showLiveGames = !isPast;
const showEventHub = showLiveGames || eventTools.length > 0;
---

<Layout {...metadata}>
  <header class="ev-head" aria-labelledby="ev-title">
    <div class="ev-head__grid" aria-hidden="true"></div>
    <div class="n-container ev-head__inner">
      <div class="ev-head__copy">
        <div class="ev-head__tags">
          {
            event.data.category && (
              <Tag
                label={event.data.category.label}
                type={event.data.category.type}
              />
            )
          }
          {
            event.data.status && (
              <Tag
                label={event.data.status.label}
                type={event.data.status.type}
              />
            )
          }
        </div>
        <div class="ev-head__mark">
          <h1
            id="ev-title"
            class:list={[
              "n-page-title",
              "ev-head__title",
              { "ev-head__title--long": longTitle },
            ]}
          >
            {event.data.name}
          </h1>
          <p class="ev-head__dim n-mono"><span>{dimLabel}</span></p>
        </div>
        <p class="n-lead ev-head__lead">{event.data.shortDescription}</p>
      </div>

      <figure class="ev-plate">
        <img
          src={poster}
          alt={`Afiche del evento ${event.data.name}`}
          width={posterSize.width}
          height={posterSize.height}
          decoding="async"
          fetchpriority="high"
        />
      </figure>

      <section class="ev-readout n-panel n-marks" aria-label="Datos del evento">
        <dl class="ev-facts">
          <div>
            <dt>Fecha</dt>
            <dd class="n-mono">
              <time datetime={dates.startISO}>{surveyDate(dates.startISO)}</time
              >
            </dd>
          </div>
          <div>
            <dt>Hora</dt>
            <dd class="n-mono">{hourRange(dates.startISO, dates.endISO)}</dd>
          </div>
          <div>
            <dt>Lugar</dt>
            <dd class="n-mono">
              {
                event.data.isVirtual ? (
                  venueShort
                ) : (
                  <a class="n-link ev-facts__place" href="#ubicacion">
                    {venueShort}
                  </a>
                )
              }
            </dd>
          </div>
          <div>
            <dt>Cupos</dt>
            <dd class="n-mono">
              <span class="ev-facts__seats">
                <strong>{event.data.participants}</strong>
                {
                  event.data.maxParticipants > 0 && (
                    <span class="n-muted">/{event.data.maxParticipants}</span>
                  )
                }
              </span>
              {
                seatsPercent !== null && (
                  <span
                    class="ev-bar"
                    role="img"
                    aria-label={`${seatsPercent}% de los cupos tomados`}
                  >
                    <span style={`width: ${seatsPercent}%`} />
                  </span>
                )
              }
            </dd>
          </div>
        </dl>

        <div class="ev-actions">
          {
            canRegister && (
              <NButton
                href={event.data.registerFormLink}
                class="ev-actions__primary"
              >
                Regístrate gratis
              </NButton>
            )
          }
          <details class="ev-cal" data-cal>
            <summary class="nb nb--ghost nb--md">
              <span class="nb__label">Añadir al calendario</span>
              <span class="nb__icon" aria-hidden="true">
                <CalendarPlus size={18} stroke-width={2} />
              </span>
            </summary>
            <div class="ev-cal__menu">
              <a href={gcalUrl} target="_blank" rel="noopener noreferrer">
                <Calendar size={18} aria-hidden="true" />
                <span>Google Calendar</span>
                <ArrowUpRight
                  size={16}
                  aria-hidden="true"
                  class="ev-cal__out"
                />
              </a>
              <a href={icsUrl} download>
                <Download size={18} aria-hidden="true" />
                <span>Descargar .ics</span>
              </a>
            </div>
          </details>
          <SharedButton
            client:visible
            title={event.data.name}
            eventDate={event.data.date}
            eventTime={event.data.time}
            eventLocation={event.data.isVirtual
              ? "Evento Virtual"
              : event.data.location.name}
            eventDescription={event.data.shortDescription}
            eventType={event.data.category.label}
            eventHashtags={JSON.stringify(event.data.tags)}
            eventOrganization="Google Developer Group Ica"
          />
        </div>
      </section>
    </div>
  </header>

  <div
    class:list={[
      "n-container",
      "ev-body",
      { "ev-body--no-hub": !showEventHub },
    ]}
  >
    {
      showEventHub && (
        <aside
          class="ev-hub n-panel n-marks"
          aria-label="Experiencias y accesos del evento"
        >
          {showLiveGames && (
            <div class="ev-play">
              <svg
                class="ev-play__glyph"
                viewBox={colibriViewBox(10)}
                aria-hidden="true"
              >
                <path
                  d={colibri}
                  fill="none"
                  stroke="currentColor"
                  stroke-width={COLIBRI_STROKE}
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
              </svg>
              <div class="ev-play__text">
                <h2 id="play-title" class="ev-play__title">
                  Dinámicas en vivo
                </h2>
                <p class="ev-play__note">
                  Quiz, bingo y ruleta en vivo desde tu celular.
                </p>
              </div>
              <NButton
                variant="ghost"
                size="sm"
                href={`/events/${event.id}/jugar`}
                class="ev-play__cta"
              >
                Entrar a los juegos
              </NButton>
            </div>
          )}

          {eventTools.length > 0 && (
            <nav class="ev-tools" aria-label="Accesos del evento">
              <ul class="ev-tools__list">
                {eventTools.map((tool) => (
                  <li data-gcp-credits-until={tool.until}>
                    <a href={tool.href} class="ev-tool">
                      <span class="ev-tool__copy">
                        <span class="ev-tool__title">{tool.title}</span>
                        <span class="ev-tool__note">{tool.note}</span>
                      </span>
                      <span class="ev-tool__arrow" aria-hidden="true">
                        <ArrowRight size={17} stroke-width={2} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </aside>
      )
    }

    <div class="ev-main">
      <section class="ev-sec" aria-labelledby="sec-about">
        <h2 id="sec-about" class="n-head ev-h2">Acerca del evento</h2>
        <div class="n-prose ev-prose">
          {paragraphs.map((text) => <p>{text}</p>)}
        </div>
      </section>

      <section class="ev-sec" id="agenda" aria-labelledby="sec-agenda">
        <h2 id="sec-agenda" class="n-head ev-h2">Agenda</h2>
        {
          hasSchedule ? (
            isTrackSchedule ? (
              <TrackTabSchedule
                schedule={schedule as TrackSchedule}
                tracks={tracks}
              />
            ) : (
              <ol class="ev-timeline">
                {isArraySchedule &&
                  (
                    schedule as {
                      id: number;
                      time: string;
                      title: string;
                      name: string;
                      image: string;
                      role: string;
                      type: string;
                    }[]
                  ).map((item) => <ScheduleCard {...item} />)}
              </ol>
            )
          ) : (
            <p class="ev-empty">
              Nuestra agenda está en construcción. ¡Vuelve pronto!
            </p>
          )
        }
      </section>

      <section class="ev-sec" id="speakers" aria-labelledby="sec-speakers">
        <div class="ev-sec__head">
          <h2 id="sec-speakers" class="n-head ev-h2">Speakers</h2>
          {
            event.data.speakers.length > 0 && (
              <p class="n-mono n-muted">
                {event.data.speakers.length}{" "}
                {event.data.speakers.length === 1 ? "speaker" : "speakers"}
              </p>
            )
          }
        </div>
        {
          event.data.speakers.length > 0 ? (
            <ul class="ev-speakers">
              {event.data.speakers.map((speaker) => (
                <li>
                  <SpeakerCard {...speaker} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="ev-empty">
              Pronto revelaremos a nuestros speakers invitados. ¡Estate atento!
            </p>
          )
        }
      </section>

      <section class="ev-sec" id="sponsors" aria-labelledby="sec-sponsors">
        <h2 id="sec-sponsors" class="n-head ev-h2">Sponsors</h2>
        {
          event.data.sponsors.length > 0 ? (
            <ul class="ev-sponsors">
              {event.data.sponsors.map((sponsor) => (
                <li class="ev-sponsor">
                  <img
                    src={sponsor.image || "/placeholder.svg"}
                    width={160}
                    height={96}
                    alt={`Logo de ${sponsor.alt}`}
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))}
            </ul>
          ) : (
            <p class="ev-empty">
              Estamos preparando una gran alianza de patrocinadores. ¡Muy
              pronto!
            </p>
          )
        }
      </section>
    </div>

    <aside class="ev-side" aria-label="Información práctica">
      {
        whatsappGroupLink && whatsappQrDataUrl && (
          <section class="ev-panel n-panel" aria-labelledby="side-wa">
            <h2 id="side-wa" class="ev-panel__title">
              Grupo de WhatsApp
            </h2>
            <p class="ev-panel__note">
              Únete al grupo del evento para recibir información sobre salones,
              charlas y novedades en tiempo real.
            </p>
            <div class="ev-qr">
              <img
                src={whatsappQrDataUrl}
                alt="QR del grupo de WhatsApp del evento"
                width={480}
                height={480}
                loading="lazy"
                decoding="async"
              />
            </div>
            <NButton variant="ghost" href={whatsappGroupLink} class="ev-wide">
              Unirse al grupo
            </NButton>
          </section>
        )
      }

      {
        event.data.requirements.length > 0 && (
          <section class="ev-panel n-panel" aria-labelledby="side-req">
            <h2 id="side-req" class="ev-panel__title">
              Requisitos
            </h2>
            <ul class="ev-list">
              {event.data.requirements.map((requirement) => (
                <li>
                  <Check size={16} stroke-width={2.4} aria-hidden="true" />
                  <span>{requirement}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        event.data.include.length > 0 && (
          <section class="ev-panel n-panel" aria-labelledby="side-inc">
            <h2 id="side-inc" class="ev-panel__title">
              Incluye
            </h2>
            <ul class="ev-list">
              {event.data.include.map((item) => (
                <li>
                  <Plus size={16} stroke-width={2.4} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        event.data.technologies.length > 0 && (
          <section class="ev-panel n-panel" aria-labelledby="side-tech">
            <h2 id="side-tech" class="ev-panel__title">
              Tecnologías
            </h2>
            <ul class="ev-tags">
              {event.data.technologies.map((technology) => (
                <li>
                  <Tag label={technology} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        !event.data.isVirtual && (
          <section
            class="ev-panel n-panel"
            id="ubicacion"
            aria-labelledby="side-loc"
          >
            <h2 id="side-loc" class="ev-panel__title">
              Ubicación
            </h2>
            <p class="ev-loc__name">{event.data.location.name}</p>
            <p class="ev-panel__note">{event.data.location.direction}</p>
            {event.data.location.googleMapEmbed ? (
              <div class="ev-map">
                <iframe
                  src={event.data.location.googleMapEmbed}
                  title={`Mapa de ${event.data.location.name}`}
                  width="600"
                  height="450"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              </div>
            ) : (
              <div class="ev-map ev-map--empty">
                <MapPinned size={18} aria-hidden="true" />
                <span>Mapa interactivo</span>
              </div>
            )}
            {event.data.location.googleMapLink && (
              <NButton
                variant="ghost"
                href={event.data.location.googleMapLink}
                class="ev-wide"
              >
                Ver en Google Maps
              </NButton>
            )}
          </section>
        )
      }
      {
        event.data.isVirtual && (
          <section class="ev-panel n-panel" aria-labelledby="side-mode">
            <h2 id="side-mode" class="ev-panel__title">
              Modalidad
            </h2>
            <p class="ev-loc__name">Evento Virtual</p>
            <p class="ev-panel__note">
              Este evento se realizará de manera virtual. El enlace de acceso se
              enviará a tu correo después del registro.
            </p>
          </section>
        )
      }
    </aside>
  </div>

  <script>
    if (new URLSearchParams(window.location.search).get("play") === "1") {
      window.location.replace(
        `${window.location.pathname.replace(/\/$/, "")}/jugar`
      );
    }
  </script>
  <script>
    // The calendar menu is a native <details>: close it on Escape (focus
    // back on its summary) and on a click anywhere outside it.
    document.addEventListener("astro:page-load", () => {
      const creditsBtn = document.querySelector<HTMLElement>(
        "[data-gcp-credits-until]"
      );
      if (creditsBtn) {
        const closesAt = Date.parse(creditsBtn.dataset.gcpCreditsUntil ?? "");
        if (Number.isFinite(closesAt) && Date.now() >= closesAt) {
          creditsBtn.hidden = true;
        }
      }

      const menu = document.querySelector<HTMLDetailsElement>("[data-cal]");
      if (!menu || menu.dataset.ready) return;
      menu.dataset.ready = "true";
      menu.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !menu.open) return;
        menu.open = false;
        menu.querySelector("summary")?.focus();
      });
      document.addEventListener("click", (event) => {
        if (menu.open && !menu.contains(event.target as Node)) {
          menu.open = false;
        }
      });
    });
  </script>
</Layout>

<style>
  .ev-head {
    position: relative;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }

  .ev-head__grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-position: right top;
    background-size: 32px 32px;
    mask-image: radial-gradient(
      ellipse 55% 90% at 85% 30%,
      #000 0%,
      transparent 75%
    );
  }

  .ev-head__inner {
    display: grid;
    grid-template-areas:
      "copy plate"
      "readout plate";
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    grid-template-rows: auto 1fr;
    gap: 2.25rem clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem)
      clamp(2.5rem, 1.75rem + 3vw, 4.5rem);
  }

  .ev-head__copy {
    grid-area: copy;
    min-width: 0;
  }

  .ev-head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .ev-head__mark {
    width: max-content;
    max-width: 100%;
  }

  .ev-head__title--long {
    font-size: clamp(2.1rem, 1.3rem + 2.6vw, 3.6rem);
    line-height: 1.02;
  }

  .ev-head__dim {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem 0 0;
    color: var(--ochre);
    white-space: nowrap;
  }

  .ev-head__dim::before,
  .ev-head__dim::after {
    height: 10px;
    min-width: 1.5rem;
    flex: 1;
    border-color: var(--ochre);
    border-style: solid;
    background: linear-gradient(var(--ochre), var(--ochre)) center / 100% 1.5px
      no-repeat;
    content: "";
  }

