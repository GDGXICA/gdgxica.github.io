---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { MuralUploadRoot } from "@/components/react/event/mural/MuralUploadRoot";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events
    .filter((event) => event.data.mural?.enabled === true)
    .map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const mural = event.data.mural!;
---

<Layout
  title={`Sube tus fotos · ${event.data.name}`}
  description={`Comparte tus fotos de ${event.data.name} en la pantalla del evento.`}
  url={`https://gdgica.com/events/${event.id}/subir`}
  noindex
>
  <main class="subir">
    <div class="subir__grid-bg" aria-hidden="true"></div>
    <div class="n-container">
      <MuralUploadRoot client:load slug={event.id} headline={mural.headline} />
    </div>
  </main>
</Layout>

<style>
  .subir {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) var(--section-gap);
    isolation: isolate;
  }

  /* The survey grid of the inner pages' heads, fading out behind the copy. */
  .subir__grid-bg {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 32rem;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-position: right top;
    background-size: 32px 32px;
    mask-image: radial-gradient(
      ellipse 55% 80% at 92% 0%,
      #000 0%,
      transparent 75%
    );
    pointer-events: none;
  }
</style>
