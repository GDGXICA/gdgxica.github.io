---
import { getCollection } from "astro:content";
import QRCode from "qrcode";
import { ArrowLeft } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import { CredentialPage } from "@/components/react/credential/CredentialPage";

// Only events that opt in via the `credential` block in gdg-ica-data get a
// route at all. Filtering here rather than rendering a disabled page means
// the URL simply 404s for every other event, which is the correct
// behaviour on a static host with no catch-all rewrite.
export async function getStaticPaths() {
  const events = await getCollection("events");
  return events
    .filter((event) => event.data.credential?.enabled === true)
    .map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const credential = event.data.credential!;

// Built here, at build time, with the same `qrcode` dependency already used
// in [slug].astro and [slug]/projector.astro. Passed to the island as a
// data: URL so the canvas can draw it same-origin — a remote image would
// taint the canvas and make toDataURL throw at export time.
//
// The organizer completes the official registration from the credential
// queue, so the QR returns to the public event page instead of asking the
// attendee to submit the same information again in Bevy.
const eventPageUrl = new URL(`/events/${event.id}/`, Astro.site).toString();
const qrDataUrl = eventPageUrl
  ? await QRCode.toDataURL(eventPageUrl, {
      errorCorrectionLevel: "M",
      margin: 0,
      width: 512,
      color: { dark: "#111827", light: "#ffffff" },
    })
  : null;

const eventInfo = {
  slug: event.id,
  eventName: event.data.name,
  eventDateLabel: event.data.date,
  headline: credential.headline,
  registrationUrl: event.data.registerFormLink,
  qrDataUrl,
};

const metadata = {
  title: `Crea tu credencial · ${event.data.name}`,
  description: `Genera tu credencial personalizada de ${event.data.name} y compártela en tus redes.`,
  image: event.data.image,
  url: `https://gdgica.com/events/${event.id}/credencial/`,
};
---

<Layout {...metadata}>
  <main class="cred">
    <div class="cred__grid-bg" aria-hidden="true"></div>
    <div class="n-container">
      <nav class="cred__nav">
        <a href={`/events/${event.id}`} class="cred__back n-link">
          <ArrowLeft size={16} stroke-width={2} aria-hidden="true" />
          Volver a {event.data.name}
        </a>
      </nav>

      <!-- Astro serializes island props; a JSON string round-trips more
         predictably than a nested object, the same workaround
         SharedButton.jsx uses for its hashtags array. -->
      <CredentialPage client:load event={JSON.stringify(eventInfo)} />
    </div>
  </main>
</Layout>

<style>
  .cred {
    position: relative;
    padding-block: clamp(1rem, 0.5rem + 2vw, 2rem) var(--section-gap);
    isolation: isolate;
  }

  /* The survey grid of the inner pages' heads, fading out behind the form. */
  .cred__grid-bg {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 34rem;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-position: right top;
    background-size: 32px 32px;
    mask-image: radial-gradient(
      ellipse 55% 80% at 92% 0%,
      #000 0%,
      transparent 75%
    );
    pointer-events: none;
  }

  .cred__nav {
    max-width: 1180px;
    margin: 0 auto clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
  }

  .cred__back {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-small);
  }

  .cred__back :global(svg) {
    color: var(--ochre);
  }
</style>

<!-- The island's own pieces that utilities cannot express: the survey
     dimension line under each step's title, the disabled and busy states of
     the chamfered button, and the grid behind the enlarged card (the modal
     is portalled to <body>, so these stay global). -->
<style is:global>
  .cred-dim {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 26rem;
    margin: 1rem 0 0;
    color: var(--ochre);
    white-space: nowrap;
  }

  .cred-dim::before,
  .cred-dim::after {
    height: 10px;
    min-width: 1.5rem;
    flex: 1;
    border-color: var(--ochre);
    border-style: solid;
    background: linear-gradient(var(--ochre), var(--ochre)) center / 100% 1.5px
      no-repeat;
    content: "";
  }

  .cred-dim::before {
    border-width: 0 0 0 1.5px;
  }

  .cred-dim::after {
    border-width: 0 1.5px 0 0;
  }

  .cred .nb.nb--busy:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .cred-modal-grid {
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-position: center;
    background-size: 42px 42px;
    mask-image: radial-gradient(circle at center, #000, transparent 72%);
  }
</style>
