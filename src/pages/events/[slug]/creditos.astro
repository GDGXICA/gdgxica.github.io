---
import { getCollection } from "astro:content";
import { ArrowLeft } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/night/PageHeader.astro";
import { GcpCreditsPage } from "@/components/react/event/GcpCreditsPage";
import { GCP_CREDITS_BY_EVENT, getGcpCreditsConfig } from "@/data/gcpCredits";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events
    .filter((event) => Boolean(GCP_CREDITS_BY_EVENT[event.id]))
    .map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const creditsConfig = getGcpCreditsConfig(event.id)!;

const metadata = {
  title: `Créditos de Google Cloud · ${event.data.name}`,
  description: `Acceso horario a los créditos de Google Cloud Platform y guía paso a paso de activación para ${event.data.name}.`,
  image: event.data.image ? `https://gdgica.com${event.data.image}` : "",
  url: `https://gdgica.com/events/${event.id}/creditos`,
  noindex: true,
};
---

<Layout {...metadata}>
  <main>
    <PageHeader
      title="Créditos de Google Cloud"
      label={`${event.data.name} · ${creditsConfig.dateLabel} · ${creditsConfig.creditsPeriodLabel}`}
      lead="Canjea tus créditos de GCP para los talleres del evento y sigue la guía paso a paso para activar tu cuenta de facturación."
    >
      <div slot="strip" class="n-container gcp-credits__strip">
        <a class="gcp-credits__back n-link" href={`/events/${event.id}`}>
          <ArrowLeft size={16} stroke-width={2} aria-hidden="true" />
          Volver a {event.data.name}
        </a>
      </div>
    </PageHeader>

    <div class="n-container gcp-credits__body">
      <noscript>
        <div class="n-panel n-marks gcp-credits__noscript">
          <p>
            Esta vista requiere JavaScript para sincronizar el horario de
            apertura ({creditsConfig.dateLabel}, {creditsConfig.viewPeriodLabel}
            ) y mostrar los enlaces de canje. Recuerda usar una cuenta personal @gmail.com.
          </p>
        </div>
      </noscript>

      <GcpCreditsPage client:load config={creditsConfig} />
    </div>
  </main>
</Layout>

<style>
  .gcp-credits__strip {
    padding-block: 0.6rem;
  }

  .gcp-credits__back {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-small);
  }

  .gcp-credits__back :global(svg) {
    color: var(--ochre);
  }

  .gcp-credits__body {
    padding-block: clamp(2rem, 1.5rem + 2.5vw, 3.5rem) var(--section-gap);
  }

  .gcp-credits__noscript {
    margin-bottom: 2rem;
    padding: 1.5rem;
    color: var(--ink);
  }
</style>
