---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import DestinationSign from "@/components/DestinationSign.astro";
import RoadTimeline from "@/components/RoadTimeline.astro";
import RouteStation from "@/components/RouteStation.astro";
import SponsorStrip from "@/components/SponsorStrip.astro";
import PhotoStrip from "@/components/PhotoStrip.astro";
import { getCollection } from "astro:content";
import { fetchStats, fetchLinks } from "@/loaders/transform-site-config";
import { getNextEvent, sortPast, sortUpcoming } from "@/utils/events";

const allEvents = await getCollection("events");
const upcoming = sortUpcoming(allEvents);
const nextEvent = getNextEvent(allEvents);
const route = [...upcoming, ...sortPast(allEvents).slice(0, 4)];

const stats = await fetchStats();
const links = await fetchLinks();
const organizers = await getCollection("organizers");
const sponsors = await getCollection("sponsors");
const speakerCount = new Set(
  allEvents.flatMap((event) => event.data.speakers.map((s) => s.name))
).size;
const sinceYear = 2015;

const photos = [
  "/carousel/06.webp",
  "/carousel/13.webp",
  "/carousel/12.webp",
  "/carousel/04.webp",
  "/carousel/16.webp",
];

const benefits = [
  {
    title: "Conectar",
    text: "Networking con profesionales, estudiantes y gente apasionada por la tecnología de Ica y alrededores.",
  },
  {
    title: "Aprender",
    text: "Charlas técnicas, talleres y study jams sobre Android, Google Cloud, Web, IA, Firebase, Flutter y más.",
  },
  {
    title: "Compartir",
    text: "Presenta tus proyectos, comparte lo que sabes y conviértete en referente para otras personas.",
  },
  {
    title: "Crecer",
    text: "Habilidades técnicas y blandas, con el respaldo de una red que te acompaña.",
  },
];

const metadata = {
  title: "GDG ICA - Google Developer Group Ica",
  description:
    "Comunidad oficial de Google Developer Group en Ica, Perú. Conectamos desarrolladores con eventos, workshops y charlas sobre Android, Cloud, IA, Flutter y Firebase.",
  url: "https://gdgica.com/",
  schema: [
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Google Developer Group ICA",
      alternateName: "GDG ICA",
      url: "https://gdgica.com",
      logo: "https://gdgica.com/gdg-logo.png",
      description:
        "Comunidad oficial de Google Developer Group en Ica, Perú, activa desde 2015.",
      sameAs: ["https://gdg.community.dev/gdg-ica/"],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "GDG ICA",
      url: "https://gdgica.com",
    },
  ],
};
---

<Layout {...metadata}>
  <h1 class="sr-only">
    GDG ICA, la comunidad de Google Developer Group en Ica
  </h1>

  <DestinationSign
    event={nextEvent}
    communityUrl={links.community}
    sinceYear={sinceYear}
    members={stats.totalMembers}
  />

  {route.length > 0 && <RoadTimeline events={route} />}

  <RouteStation
    id="unete"
    title="Únete a la comunidad"
    glyph="mono"
    tone="green"
  >
    <p>
      Somos una comunidad de jóvenes apasionados por la tecnología en Ica. Nos
      juntamos para aprender, compartir lo que sabemos y crecer, en eventos
      gratuitos y presenciales.
    </p>
    <dl class="plate bg-sign-white divide-ink/15 divide-y-2 text-base">
      {
        benefits.map((benefit) => (
          <div class="grid gap-1 px-5 pt-4 pb-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-6">
            <dt class="text-lg font-black">{benefit.title}</dt>
            <dd class="text-ink-muted">{benefit.text}</dd>
          </div>
        ))
      }
    </dl>
    <dl class="grid grid-cols-3 gap-2 sm:gap-3">
      {
        [
          { value: `${stats.totalMembers}+`, label: "miembros" },
          { value: organizers.length, label: "organizadores" },
          { value: speakerCount, label: "speakers recientes" },
        ].map((figure) => (
          <div class="plate bg-sign-white flex flex-col-reverse gap-1 px-3 pt-3 pb-2 sm:px-5 sm:pt-4 sm:pb-3">
            <dt class="text-ink-muted text-sm font-bold">{figure.label}</dt>
            <dd class="text-2xl leading-none font-black tabular-nums sm:text-[2rem]">
              {figure.value}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button variant="green" href={links.community} target="_blank">
        Únete en gdg.community.dev
      </Button>
      <Button variant="outline" href="/about">Conoce al equipo</Button>
    </div>
  </RouteStation>

  <PhotoStrip photos={photos} label="Fotos de eventos de GDG Ica" />

  <RouteStation
    id="apoya"
    title="Apoya a la comunidad"
    glyph="palmera"
    tone="yellow"
    reverse
  >
    <p>
      Empresas, instituciones y emprendimientos de la región hacen posible que
      nuestros eventos sean gratuitos. Llega a cientos de devs y estudiantes de
      Ica.
    </p>
    {sponsors.length > 0 && <SponsorStrip sponsors={sponsors} />}
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button variant="yellow" href={links.forms.sponsor} target="_blank">
        Quiero ser sponsor
      </Button>
      <Button variant="outline" href="/sponsors">Ver patrocinadores</Button>
    </div>
  </RouteStation>

  <RouteStation
    id="participa"
    title="Da una charla o sé voluntario"
    glyph="arana"
    tone="blue"
  >
    <p>
      ¿Tienes algo que contar o quieres ayudar a organizar? Buscamos speakers
      para nuestros eventos y voluntarios para logística, contenido, diseño y el
      día del evento.
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button variant="solid" href={links.forms.volunteer} target="_blank">
        Postula como voluntario
      </Button>
      <Button variant="outline" href={links.forms.proposeEvent} target="_blank">
        Propón una charla
      </Button>
    </div>
    <a
      href="/volunteers"
      class="self-start text-base font-bold underline decoration-2 hover:decoration-4"
    >
      Conoce los roles de voluntariado
    </a>
  </RouteStation>
</Layout>
