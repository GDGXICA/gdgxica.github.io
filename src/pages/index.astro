---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/home/Hero.astro";
import CredentialSection from "@/components/home/CredentialSection.astro";
import EventLog from "@/components/home/EventLog.astro";
import CommunityPhotos from "@/components/home/CommunityPhotos.astro";
import Closing from "@/components/home/Closing.astro";
import { getCollection } from "astro:content";
import { parseSpanishDate } from "@/utils/parseSpanishDate";
import { getEventDates } from "@/utils/eventDates";
import {
  dottedDate,
  hourRange,
  shortVenue,
  surveyDate,
} from "@/utils/eventShort";
import { fetchStats, fetchLinks } from "@/loaders/transform-site-config";

const allEvents = await getCollection("events");
const time = (date: string) => parseSpanishDate(date).getTime();

const upcoming = allEvents
  .filter((event) => event.data.status.type === "upcoming")
  .sort((a, b) => time(a.data.date) - time(b.data.date));
const past = allEvents
  .filter((event) => event.data.status.type !== "upcoming")
  .sort((a, b) => time(b.data.date) - time(a.data.date));

// The hero reads out the next highlighted event; between seasons it offers
// the community instead.
const next = upcoming.find((event) => event.data.isHighlight) ?? upcoming[0];
const heroEvent = next
  ? {
      slug: next.id,
      name: next.data.name,
      date: next.data.date,
      time: next.data.time,
      venue: next.data.location.name,
      isVirtual: next.data.isVirtual,
      registerFormLink: next.data.registerFormLink,
      participants: next.data.participants,
      maxParticipants: next.data.maxParticipants,
    }
  : null;

// The credential section exists only for an event that opted into the
// credential page; otherwise its button would lead to a 404.
const credentialEvent =
  next && next.data.credential?.enabled
    ? {
        slug: next.id,
        name: next.data.name,
        date: next.data.date,
        time: next.data.time,
        venue: next.data.location.name,
        isVirtual: next.data.isVirtual,
      }
    : null;

// The event log pins the next event on the right and lists every other
// one, upcoming then past, on the left.
const nextDates = next ? getEventDates(next.data) : null;
const nextEvent =
  next && nextDates
    ? {
        slug: next.id,
        name: next.data.name,
        image: next.data.image,
        categoryLabel: next.data.category.label,
        date: surveyDate(nextDates.startISO),
        hours: hourRange(nextDates.startISO, nextDates.endISO),
        venue: shortVenue(next.data.location.name, next.data.isVirtual),
        startISO: nextDates.startISO,
        registerFormLink: next.data.registerFormLink,
      }
    : null;

const rows = [...upcoming, ...past]
  .filter((event) => event.id !== next?.id)
  .map((event) => {
    const startISO = getEventDates(event.data).startISO;
    return {
      slug: event.id,
      name: event.data.name,
      image: event.data.image,
      categoryType: event.data.category.type,
      categoryLabel: event.data.category.label,
      date: dottedDate(startISO),
      year: dottedDate(startISO).slice(-4),
      venue: shortVenue(event.data.location.name, event.data.isVirtual),
      upcoming: event.data.status.type === "upcoming",
    };
  });

const photos = (await getCollection("gallery")).slice(0, 8).map((photo) => ({
  src: photo.data.src,
  alt: `${photo.data.title} de GDG Ica: ${photo.data.description}`,
}));

const stats = await fetchStats();
const links = await fetchLinks();

const metadata = {
  title: "GDG ICA - Google Developer Group Ica",
  description:
    "Comunidad oficial de Google Developer Group en Ica, Perú. Conectamos desarrolladores con eventos, workshops y charlas sobre Android, Cloud, IA, Flutter y Firebase.",
  image: "https://gdgica.com/gdg-logo.png",
  url: "https://gdgica.com/",
  schema: [
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Google Developer Group ICA",
      alternateName: "GDG ICA",
      url: "https://gdgica.com",
      logo: "https://gdgica.com/gdg-logo.png",
      description:
        "Comunidad oficial de Google Developer Group en Ica, Perú. Más de 1000 miembros activos, 50+ eventos y 10 años conectando desarrolladores.",
      sameAs: ["https://gdg.community.dev/gdg-ica/"],
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "GDG ICA",
      url: "https://gdgica.com",
    },
  ],
};
---

<Layout {...metadata} theme="night">
  <main>
    <Hero
      event={heroEvent}
      communityUrl={links.community}
      stats={{
        yearsActive: stats.yearsActive,
        totalMembers: stats.totalMembers,
        totalEvents: stats.totalEvents,
        totalSpeakers: stats.totalSpeakers,
      }}
    />
    {credentialEvent && <CredentialSection {...credentialEvent} />}
    <EventLog next={nextEvent} rows={rows} communityUrl={links.community} />
    <CommunityPhotos photos={photos} />
    <Closing communityUrl={links.community} contactUrl={links.forms.contact} />
  </main>
</Layout>

<script>
  // Section heads and the photo wall settle in once as they arrive. The
  // hidden state is keyed to this class, so without the script nothing is
  // ever hidden.
  function reveal() {
    const pending = new Set(
      document.querySelectorAll<HTMLElement>("[data-reveal]")
    );
    if (!pending.size) return;
    document.body.classList.add("js-motion");

    const show = (el: HTMLElement) => {
      el.classList.add("is-in");
      pending.delete(el);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          show(entry.target as HTMLElement);
          io.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -10% 0px" }
    );
    pending.forEach((el) => io.observe(el));

    // A fast fling on a busy device can carry an element across the
    // viewport between two frames, so the observer never sees it cross.
    // Anything already above the fold line is shown on the next scroll.
    let ticking = false;
    const sweep = () => {
      ticking = false;
      const line = window.innerHeight * 0.9;
      pending.forEach((el) => {
        if (el.getBoundingClientRect().top < line) {
          io.unobserve(el);
          show(el);
        }
      });
      if (!pending.size) window.removeEventListener("scroll", onScroll);
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sweep);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  document.addEventListener("astro:page-load", reveal);
</script>
