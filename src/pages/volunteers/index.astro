---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/night/PageHeader.astro";
import NButton from "@/components/night/NButton.astro";
import StatsBar from "@/components/StatsBar.astro";
import VolunteerCard from "@/components/VolunteerCard.astro";
import VolunteerRoleCard from "@/components/VolunteerRoleCard.astro";
import CallToActionSection from "@/components/CallToActionSection.astro";
import { getCollection } from "astro:content";
import { fetchStats, fetchLinks } from "@/loaders/transform-site-config";

const volunteersCollection = await getCollection("volunteers");
const volunteers = volunteersCollection.map((entry) => entry.data);
const volunteerRolesCollection = await getCollection("volunteerRoles");
const hiddenRoleTitles = new Set(["Soporte Técnico", "Traducción y Contenido"]);
const roles = volunteerRolesCollection
  .map((entry) => entry.data)
  .filter((role) => !hiddenRoleTitles.has(role.title));
const stats = await fetchStats();
const links = await fetchLinks();

const metadata = {
  title: "Voluntariado - Google Developer Group Ica",
  description:
    "Descubre cómo aportar tu tiempo y habilidades como voluntario de GDG Ica y conoce a las personas que apoyan nuestras iniciativas.",
  image: "https://gdgica.com/gdg-logo.png",
  url: "https://gdgica.com/volunteers/",
};
---

<Layout {...metadata}>
  <main>
    <PageHeader
      title="Voluntariado"
      label="Haz la diferencia como voluntario"
      lead="El voluntariado es una forma flexible de aportar a iniciativas concretas de GDG Ica. No necesitas formar parte del equipo organizador: puedes colaborar desde tus habilidades, intereses y disponibilidad."
    >
      <NButton href={links.forms.volunteer}>Quiero ser voluntario</NButton>
      <NButton variant="ghost" href="#oportunidades">
        Ver oportunidades
      </NButton>
      <StatsBar
        slot="strip"
        stats={[
          {
            value: `${stats.activeVolunteers}+`,
            label: "voluntarios activos",
          },
          {
            value: `${stats.volunteerHours}+`,
            label: "horas contribuidas",
          },
          {
            value: `${stats.eventsSupported}+`,
            label: "eventos apoyados",
          },
          {
            value: `${stats.volunteerAreas}`,
            label: "áreas de apoyo",
          },
        ]}
      />
    </PageHeader>

    <section id="oportunidades" class="roles" aria-labelledby="roles-title">
      <div class="n-container roles__grid">
        <div class="roles__intro">
          <h2 id="roles-title" class="n-head">Oportunidades de voluntariado</h2>
          <p class="n-lead">
            Encuentra un área que conecte con tus habilidades e intereses y
            descubre cómo puedes aportar.
          </p>
        </div>
        <ol class="roles__list">
          {
            roles.map((role, index) => (
              <li>
                <VolunteerRoleCard {...role} index={index + 1} />
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      volunteers.length > 0 && (
        <section class="crew" aria-labelledby="crew-title">
          <div class="n-container">
            <div class="crew__intro">
              <h2 id="crew-title" class="n-head">
                Nuestra comunidad voluntaria
              </h2>
              <p class="n-lead">
                Reconocemos a quienes aportan su tiempo y talento para hacer
                posibles nuestros eventos e iniciativas.
              </p>
            </div>
            <ul id="volunteers-grid" class="crew__roster">
              {volunteers.map((volunteer) => (
                <li>
                  <VolunteerCard volunteer={volunteer} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <CallToActionSection>
      <h2>¿Quieres colaborar con GDG Ica?</h2>
      <p>
        Cuéntanos qué te interesa y cuánto tiempo puedes aportar. Buscaremos una
        oportunidad concreta en la que puedas participar.
      </p>
      <NButton href={links.forms.volunteer}>Quiero ser voluntario</NButton>
    </CallToActionSection>
  </main>
</Layout>

<style>
  /* ---- roles ---- */
  .roles {
    padding-block: var(--section-gap);
    scroll-margin-top: 4rem;
  }

  .roles__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .roles__intro {
    position: sticky;
    top: 6rem;
  }

  .roles__intro h2 {
    margin: 0;
  }

  .roles__intro p {
    max-width: 32ch;
    margin: 1.25rem 0 0;
    color: var(--muted);
  }

  .roles__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .roles__list > li {
    border-top: 1px solid var(--line);
  }

  /* ---- the volunteers ---- */
  .crew {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--line);
  }

  .crew__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .crew__intro h2 {
    margin: 0;
  }

  .crew__intro p {
    max-width: 44ch;
    margin: 0;
    color: var(--muted);
  }

  .crew__roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crew__roster > li {
    border-top: 1px solid var(--line);
  }

  @media (max-width: 1023px) {
    .roles__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .roles__intro {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .crew__intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
