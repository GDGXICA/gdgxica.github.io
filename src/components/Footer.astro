---
import { fetchLinks } from "@/loaders/transform-site-config";
import Geoglyph from "@/components/illustrations/Geoglyph.astro";

const siteLinks = await fetchLinks();
const year = new Date().getFullYear();

const columns = [
  {
    title: "Comunidad",
    links: [
      { text: "Nosotros", url: "/about" },
      { text: "Voluntariado", url: "/volunteers" },
      { text: "Foro", url: "/foro" },
      { text: "Únete en community.dev", url: siteLinks.community },
    ],
  },
  {
    title: "Eventos",
    links: [
      { text: "Todos los eventos", url: "/events" },
      { text: "Patrocinadores", url: "/sponsors" },
      { text: "Propón un evento", url: siteLinks.forms.proposeEvent },
    ],
  },
  {
    title: "Síguenos",
    links: [
      { text: "LinkedIn", url: siteLinks.social.linkedin },
      { text: "Instagram", url: siteLinks.social.instagram },
      { text: "Facebook", url: siteLinks.social.facebook },
    ],
  },
];

const isExternal = (url: string) => url.startsWith("http");
---

<footer class="theme-night">
  <div class="bg-sand h-3" aria-hidden="true"></div>
  <div class="bg-sign-white h-1.5" aria-hidden="true"></div>
  <div class="max-w-site mx-auto px-4 pt-14 pb-10 md:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_2fr]">
      <div class="flex items-start gap-5">
        <Geoglyph
          name="colibri"
          class="text-sign-yellow h-24 w-24 flex-none"
          strokeWidth={6}
        />
        <div>
          <p class="text-2xl font-black tracking-tight">GDG ICA</p>
          <p class="text-asphalt-muted mt-2 max-w-sm">
            La comunidad de Google Developer Group en Ica, Perú. Aprendemos,
            compartimos y construimos juntos desde 2015.
          </p>
        </div>
      </div>
      <div class="grid gap-10 sm:grid-cols-3">
        {
          columns.map((column) => (
            <div>
              <p class="text-sign-yellow text-sm font-extrabold tracking-[0.12em] uppercase">
                {column.title}
              </p>
              <ul class="mt-4 flex flex-col gap-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target={isExternal(link.url) ? "_blank" : undefined}
                      rel={
                        isExternal(link.url) ? "noopener noreferrer" : undefined
                      }
                      class="font-semibold text-white decoration-2 hover:underline"
                    >
                      {link.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="road-lane h-2" aria-hidden="true"></div>
  <div
    class="max-w-site text-asphalt-muted mx-auto flex flex-col gap-4 px-4 py-8 text-sm md:flex-row md:items-center md:justify-between md:px-8"
  >
    <p>© {year} GDG ICA. Todos los derechos reservados.</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li>
        <a
          href="https://github.com/GDGXICA/gdgxica.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-white"
        >
          Contribuye en GitHub
        </a>
      </li>
      <li>
        <a href="/terms-and-conditions" class="underline hover:text-white">
          Términos y condiciones
        </a>
      </li>
      <li>
        <a href="/privacy-policy" class="underline hover:text-white">
          Política de privacidad
        </a>
      </li>
      <li>
        <a href="/creditos" class="underline hover:text-white">
          Créditos y licencias
        </a>
      </li>
    </ul>
  </div>
</footer>
