---
import { COLIBRI_STROKE, colibriPath, colibriViewBox } from "@/lib/colibri";
import { getEventDates } from "@/utils/eventDates";
import { badgeDate, shortVenue } from "@/utils/eventShort";
import { PREFILL_PARAM } from "@/components/react/credential/prefill";
import NButton from "@/components/night/NButton.astro";
import { ChevronRight } from "@lucide/astro";

interface Props {
  slug: string;
  name: string;
  date: string;
  time: string;
  venue: string;
  isVirtual: boolean;
}

const props = Astro.props;
const dates = getEventDates(props);
const line = [
  badgeDate(dates.startISO),
  shortVenue(props.venue, props.isVirtual),
].join(" · ");
const action = `/events/${props.slug}/credencial`;
// A survey reticle behind the card: ticks every 10°, longer every 30°.
const ticks = Array.from({ length: 36 }, (_, i) => {
  const angle = (i * 10 * Math.PI) / 180;
  const inner = i % 3 === 0 ? 176 : 184;
  return {
    x1: Math.sin(angle) * inner,
    y1: -Math.cos(angle) * inner,
    x2: Math.sin(angle) * 192,
    y2: -Math.cos(angle) * 192,
  };
});
// "28 de noviembre", in Ica's time zone.
const deadline = new Intl.DateTimeFormat("es-PE", {
  timeZone: "America/Lima",
  day: "numeric",
  month: "long",
}).format(new Date(dates.startISO));
// Printed along the lanyard, like the real ones.
const strapPrint = Array.from({ length: 6 }, () => "GDG ICA").join(" · ");
---

<section class="credsec" aria-labelledby="credsec-title" data-credsec>
  <div class="n-container credsec__grid">
    <div class="credsec__copy" data-reveal>
      <h2 id="credsec-title" class="n-head">Ponte la credencial</h2>
      <p class="n-lead n-muted">
        Escribe tu nombre y míralo en tu credencial del {props.name}. Créala y
        compártela antes del {deadline}.
      </p>
      <form class="credsec__form" action={action} method="get">
        <label for="credsec-name">Nombre en la credencial</label>
        <div class="credsec__bar">
          <span class="credsec__prompt" aria-hidden="true">
            <ChevronRight size={18} stroke-width={2.2} />
          </span>
          <input
            id="credsec-name"
            name={PREFILL_PARAM}
            type="text"
            maxlength="80"
            autocomplete="name"
            placeholder="Nombre y apellido"
            data-cred-input
          />
          <NButton type="submit">Crear credencial</NButton>
        </div>
      </form>
    </div>

    <div class="credsec__stage n-panel n-marks" data-cred-stage>
      <div class="cred-plate" aria-hidden="true">
        <svg class="cred-reticle" viewBox="-210 -210 420 420">
          <circle r="96"></circle>
          <circle r="146" class="cred-reticle__dash"></circle>
          <circle r="192"></circle>
          <line x1="-210" y1="0" x2="-150" y2="0"></line>
          <line x1="150" y1="0" x2="210" y2="0"></line>
          <line x1="0" y1="-210" x2="0" y2="-150"></line>
          <line x1="0" y1="150" x2="0" y2="210"></line>
          {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
          <text x="0" y="-198">000</text>
          <text x="200" y="4">090</text>
          <text x="-200" y="4">270</text>
        </svg>
      </div>
      <span class="cred-mount" aria-hidden="true"></span>
      <div class="cred-swing">
        <span class="callout callout--strap" aria-hidden="true">
          <span class="callout__dot"></span><span class="callout__line"
          ></span><span class="callout__label n-mono">Cinta GDG Ica</span>
        </span>
        <span class="callout callout--emblem" aria-hidden="true">
          <span class="callout__label n-mono">Colibrí de Nazca</span><span
            class="callout__line"></span><span class="callout__dot"></span>
        </span>
        <span class="callout callout--name" aria-hidden="true">
          <span class="callout__label n-mono">Tu nombre, en vivo</span><span
            class="callout__line"></span><span class="callout__dot"></span>
        </span>
        <div class="cred-strap" aria-hidden="true">
          <span class="n-mono">{strapPrint}</span>
        </div>
        <span class="cred-clip" aria-hidden="true"><span></span></span>
        <article
          class="cred"
          data-cred
          aria-label={`Vista previa de tu credencial del ${props.name}`}
        >
          <div class="cred__field">
            <span class="cred__slot" aria-hidden="true"></span>
            <p class="cred__event">{props.name}</p>
            <svg
              class="cred__emblem"
              viewBox={colibriViewBox(3)}
              aria-hidden="true"
            >
              <path
                d={colibriPath()}
                fill="none"
                stroke="currentColor"
                stroke-width={COLIBRI_STROKE * 1.1}
                stroke-linejoin="round"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <div class="cred__body">
            <p class="cred__name" data-cred-name>Tu nombre</p>
            <p class="cred__role">Asistente</p>
            <p class="cred__line n-mono">{line}</p>
          </div>
          <span class="cred__sheen" aria-hidden="true"></span>
        </article>
        <span class="cred-shadow" aria-hidden="true"></span>
      </div>
      <div class="cred-plate__foot n-mono" aria-hidden="true">
        <span>Credencial · {props.name}</span>
        <span class="cred-plate__live">Vista previa en vivo</span>
      </div>
    </div>
  </div>
</section>

<style>
  .credsec {
    padding-block: var(--section-gap);
    border-block: 1px solid var(--line);
    background: var(--surface-1);
  }

  .credsec__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .credsec__copy h2 {
    margin: 0;
  }

  .credsec__copy .n-lead {
    max-width: 36ch;
    margin: 1.25rem 0 0;
  }

  .credsec__form {
    max-width: 34rem;
    margin-top: 2.25rem;
  }

  .credsec__form label {
    display: block;
    margin-bottom: 0.6rem;
    font-weight: 500;
  }

  /* A command bar: an ochre prompt, the field and the action in one
     chamfered strip. Its edge is a step in tone from the section, which
     follows the chamfer where an outline could not; focus lifts the tone. */
  .credsec__bar {
    --cut: 10px;
    display: flex;
    align-items: stretch;
    padding: 4px;
    background: var(--night);
    clip-path: polygon(
      0 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut))
    );
    transition: background-color 160ms ease;
  }

  .credsec__bar:hover {
    background: #0a1020;
  }

  .credsec__bar:focus-within {
    background: var(--surface-2);
  }

  .credsec__prompt {
    display: grid;
    width: 2.25rem;
    flex: none;
    place-items: center;
    color: var(--ochre);
  }

  .credsec__form input {
    min-width: 0;
    min-height: 3rem;
    flex: 1;
    padding: 0.6rem 0.75rem 0.6rem 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
  }

  .credsec__form input::placeholder {
    color: var(--muted);
  }

  .credsec__form input:focus-visible {
    outline: none;
  }

  /* ---- the credential, hanging in 3D ---- */
  /* The stage is a survey plate: a fine measuring grid on the night ground,
     the credential hung from a mount on its top rule. */
  .credsec__stage {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --sheen-x: 30%;
    --sheen-y: 20%;
    --card-w: clamp(15rem, 22vw, 20rem);
    --strap-h: clamp(5rem, 9vw, 7rem);
    display: flex;
    min-height: clamp(32rem, 40vw, 38rem);
    flex-direction: column;
    align-items: center;
    padding: 0 1.5rem 3.5rem;
    background: var(--night);
    perspective: 1100px;
  }

  /* The plate behind the card: a measuring grid that fades out towards the
     edges, a pool of ochre light, and a survey reticle centred on the card. */
  .cred-plate {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cred-plate::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-position: center top;
    background-size: 24px 24px;
    content: "";
    mask-image: radial-gradient(
      ellipse 70% 65% at 50% 48%,
      #000 35%,
      transparent 100%
    );
  }

  .cred-plate::after {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 42% 46% at 50% 46%,
      rgb(212 173 98 / 0.13),
      rgb(212 173 98 / 0) 70%
    );
    content: "";
  }

  .cred-reticle {
    position: absolute;
    top: calc(var(--strap-h) + var(--card-w) * 0.7);
    left: 50%;
    width: min(calc(var(--card-w) * 1.9), 94%);
    fill: none;
    stroke: rgb(212 173 98 / 0.28);
    stroke-width: 1;
    transform: translate(-50%, -50%);
  }

  .cred-reticle__dash {
    stroke-dasharray: 3 7;
  }

  .cred-reticle text {
    fill: rgb(212 173 98 / 0.6);
    font-family: var(--font-mono);
    font-size: 10px;
    stroke: none;
    text-anchor: middle;
  }

  .cred-plate__foot {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    left: 1.25rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
  }

  .cred-plate__live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ochre);
  }

  .cred-plate__live::before {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ochre);
    content: "";
    animation: plate-live 2.4s ease-in-out infinite;
  }

  @keyframes plate-live {
    50% {
      opacity: 0.3;
    }
  }

  /* Callouts: a dot on the part, a leader line, a label. */
  .callout {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0;
    color: var(--ochre);
    white-space: nowrap;
    pointer-events: none;
  }

  .callout__dot {
    width: 7px;
    height: 7px;
    flex: none;
    border: 1.5px solid var(--ochre);
    border-radius: 50%;
    background: var(--night);
  }

  .callout__line {
    width: var(--reach, 2.5rem);
    height: 1px;
    background: var(--ochre);
  }

  .callout__label {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgb(7 11 22 / 0.85);
    color: var(--ink);
  }

  .callout--strap {
    top: calc(var(--strap-h) * 0.45);
    left: calc(50% + 0.9rem);
  }

  /* The leader reaches from the dot on the part past the card's edge, so
     the label always sits clear of the card. */
  /* The dot lands on the hummingbird's beak. */
  .callout--emblem {
    --reach: calc(var(--card-w) * 0.28 + 2.25rem);
    top: calc(var(--strap-h) + var(--card-w) * 1.4 * 0.21);
    right: calc(50% + var(--card-w) * 0.22);
  }

  .callout--name {
    --reach: calc(var(--card-w) * 0.1 + 2.25rem);
    top: calc(var(--strap-h) + var(--card-w) * 1.4 * 0.74);
    right: calc(50% + var(--card-w) * 0.4);
  }

  @media (max-width: 1180px) {
    .callout {
      display: none;
    }
  }

  .cred-mount {
    position: absolute;
    top: -3px;
    left: 50%;
    width: 4.5rem;
    height: 6px;
    border-radius: 3px;
    background: var(--ochre);
    transform: translateX(-50%);
  }

  .cred-swing {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
    animation: cred-sway 8s ease-in-out infinite;
    transform-style: preserve-3d;
  }

  /* A woven strap with stitched edges and the event printed along it,
     hanging from the mount. */
  .cred-strap {
    position: relative;
    width: 2.6rem;
    height: var(--strap-h);
    overflow: hidden;
    border-inline: 3px solid #1b4fc0;
    background: var(--g-blue);
    box-shadow:
      inset 4px 0 0 -2px rgb(255 255 255 / 0.28),
      inset -4px 0 0 -2px rgb(255 255 255 / 0.28);
  }

  .cred-strap span {
    position: absolute;
    top: 0;
    left: 50%;
    color: rgb(255 255 255 / 0.85);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
    transform: translateX(-50%);
    writing-mode: vertical-rl;
  }

  /* A metal clasp: a ring on the strap, a tongue into the card's slot, on
     the card's centre line. */
  .cred-clip {
    position: relative;
    z-index: 2;
    display: grid;
    width: 1.5rem;
    height: 2.4rem;
    margin-top: -0.4rem;
    margin-bottom: -1.5rem;
    place-items: end center;
    border-radius: 0.75rem 0.75rem 4px 4px;
    background: linear-gradient(90deg, #8d95a3, #e3e7ee 45%, #9aa2b0);
  }

  .cred-clip span {
    width: 0.55rem;
    height: 0.9rem;
    margin-bottom: 0.3rem;
    border-radius: 2px;
    background: #5d6573;
  }

  .cred {
    position: relative;
    display: flex;
    width: var(--card-w);
    aspect-ratio: 5 / 7;
    flex-direction: column;
    overflow: hidden;
    border-radius: 14px;
    background: var(--paper);
    color: var(--paper-ink);
    transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transition: transform 240ms var(--ease-out);
  }

  .cred__field {
    position: relative;
    display: flex;
    flex: 1.15;
    flex-direction: column;
    align-items: center;
    padding: 1.8rem 1.25rem 1rem;
    background: #c8a55a;
    color: #ffffff;
  }

  .cred__slot {
    position: absolute;
    top: 0.75rem;
    left: 50%;
    width: 2.6rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--night);
    transform: translateX(-50%);
  }

  .cred__event {
    margin: 0;
    color: var(--paper-ink);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .cred__emblem {
    display: block;
    width: 74%;
    margin: auto;
  }

  .cred__body {
    padding: 1rem 1.25rem 1.2rem;
  }

  .cred__body p {
    margin: 0;
  }

  .cred__name {
    display: -webkit-box;
    overflow: hidden;
    overflow-wrap: anywhere;
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .cred__name.is-long {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
  }

  .cred__role {
    margin-top: 0.3rem;
    color: var(--paper-muted);
  }

  .cred__line {
    margin-top: 0.8rem;
    color: var(--paper-muted);
  }

  /* Light moving across the card as it turns. */
  .cred__sheen {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--sheen-x) var(--sheen-y),
      rgb(255 255 255 / 0.32),
      rgb(255 255 255 / 0) 45%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .cred-shadow {
    width: 70%;
    height: 1.2rem;
    margin-top: 2.5rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    filter: blur(12px);
  }

  @keyframes cred-sway {
    0%,
    100% {
      transform: rotateZ(-1.2deg);
    }
    50% {
      transform: rotateZ(1.2deg);
    }
  }

  @media (max-width: 899px) {
    .credsec__grid {
      grid-template-columns: 1fr;
    }

    /* The card above the field, so it stays in view while typing. */
    .cred-plate__foot span:first-child {
      display: none;
    }

    .cred-plate__foot {
      justify-content: flex-end;
    }

    .credsec__stage {
      --card-w: min(64vw, 15rem);
      --strap-h: 2.5rem;
      order: -1;
      min-height: auto;
      padding-bottom: 3rem;
    }

    .cred-shadow {
      margin-top: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .credsec__bar {
      flex-wrap: wrap;
    }

    .credsec__form input {
      flex-basis: calc(100% - 2.25rem);
    }

    .credsec__bar :global(.nb) {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cred-swing {
      animation: none;
    }

    .cred {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-credsec]");
    if (!root) return;
    const stage = root.querySelector<HTMLElement>("[data-cred-stage]");
    const card = root.querySelector<HTMLElement>("[data-cred]");
    const name = root.querySelector<HTMLElement>("[data-cred-name]");
    const input = root.querySelector<HTMLInputElement>("[data-cred-input]");

    if (input && name) {
      const placeholder = name.textContent ?? "";
      input.oninput = () => {
        const value = input.value.replace(/\s+/g, " ").trim();
        name.textContent = value || placeholder;
        name.classList.toggle("is-long", value.length > 16);
      };
      // On a phone the keyboard covers half the screen: bring the card into
      // view above the field so the name can be watched as it is typed.
      input.onfocus = () => {
        if (window.matchMedia("(max-width: 899px)").matches && stage) {
          stage.scrollIntoView({ block: "start", behavior: "smooth" });
        }
      };
    }

    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!stage || !card || !fine.matches || still.matches) return;

    root.onpointermove = (event) => {
      const rect = card.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width;
      const y = (event.clientY - rect.top) / rect.height;
      const clamp = (v: number) => Math.max(-1, Math.min(1, v));
      stage.style.setProperty("--tilt-y", `${clamp(x - 0.5) * 18}deg`);
      stage.style.setProperty("--tilt-x", `${clamp(0.5 - y) * 12}deg`);
      stage.style.setProperty("--sheen-x", `${Math.round(x * 100)}%`);
      stage.style.setProperty("--sheen-y", `${Math.round(y * 100)}%`);
    };
    root.onpointerleave = () => {
      stage.style.setProperty("--tilt-y", "0deg");
      stage.style.setProperty("--tilt-x", "0deg");
      stage.style.setProperty("--sheen-x", "30%");
      stage.style.setProperty("--sheen-y", "20%");
    };
  });
</script>
