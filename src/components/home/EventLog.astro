---
import { ArrowRight } from "@lucide/astro";
import NButton from "@/components/night/NButton.astro";

export interface EventRow {
  slug: string;
  name: string;
  image: string;
  categoryType: string;
  categoryLabel: string;
  date: string;
  year: string;
  venue: string;
  upcoming: boolean;
}

export interface NextEvent {
  slug: string;
  name: string;
  image: string;
  categoryLabel: string;
  date: string;
  hours: string;
  venue: string;
  startISO: string;
  registerFormLink: string;
}

interface Props {
  /** The next event, pinned on the right. Null between seasons. */
  next: NextEvent | null;
  /** Every other event, newest first. */
  rows: EventRow[];
  communityUrl: string;
}

const { next, rows, communityUrl } = Astro.props;

// Grouped by year, like the pages of a logbook.
const years = rows.reduce<{ year: string; rows: EventRow[] }[]>(
  (groups, row) => {
    const last = groups.at(-1);
    if (last && last.year === row.year) last.rows.push(row);
    else groups.push({ year: row.year, rows: [row] });
    return groups;
  },
  []
);
---

<section class="log" aria-labelledby="log-title">
  <div class="n-container">
    <div class="n-section-head" data-reveal>
      <h2 id="log-title" class="n-head">Eventos de la comunidad</h2>
      <a class="n-link" href="/events">Ver el calendario completo</a>
    </div>

    <div class="log__body">
      <div class="log__years">
        {
          years.map((group) => (
            <section class="log__year" aria-label={`Eventos de ${group.year}`}>
              <h3 class="log__year-label n-mono">{group.year}</h3>
              <ol class="log__list">
                {group.rows.map((row) => (
                  <li>
                    <a class="log__row" href={`/events/${row.slug}`}>
                      <span class="log__thumb">
                        <img
                          src={row.image}
                          alt=""
                          width={96}
                          height={96}
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                      <span class="log__text">
                        <span class="log__name">{row.name}</span>
                        <span class="log__meta n-mono">
                          <span>{row.date}</span>
                          <span class="log__cat">
                            <span
                              class={`log__dot log__dot--${row.categoryType}`}
                              aria-hidden="true"
                            />
                            {row.categoryLabel}
                          </span>
                          <span>{row.venue}</span>
                          {row.upcoming && (
                            <span class="log__next">Próximo</span>
                          )}
                        </span>
                      </span>
                      <span class="log__go" aria-hidden="true">
                        <ArrowRight size={18} stroke-width={2} />
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>

      <aside class="log__aside" aria-labelledby="log-next-title">
        <div class="next n-panel n-marks">
          {
            next ? (
              <>
                <div class="next__head n-mono">
                  <span class="next__badge">Próximo evento</span>
                  <span class="next__count" data-next-countdown={next.startISO}>
                    {next.date}
                  </span>
                </div>
                <a
                  class="next__plate"
                  href={`/events/${next.slug}`}
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <img
                    src={next.image}
                    alt=""
                    width={640}
                    height={480}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <h3 id="log-next-title" class="next__title">
                  {next.name}
                </h3>
                <dl class="next__facts n-mono">
                  <div>
                    <dt>Fecha</dt>
                    <dd>{next.date}</dd>
                  </div>
                  <div>
                    <dt>Hora</dt>
                    <dd>{next.hours}</dd>
                  </div>
                  <div>
                    <dt>Lugar</dt>
                    <dd>{next.venue}</dd>
                  </div>
                  <div>
                    <dt>Tipo</dt>
                    <dd>{next.categoryLabel}</dd>
                  </div>
                </dl>
                <div class="next__actions">
                  <NButton href={`/events/${next.slug}`}>
                    Ver detalles del evento
                  </NButton>
                  {next.registerFormLink && (
                    <NButton variant="ghost" href={next.registerFormLink}>
                      Regístrate gratis
                    </NButton>
                  )}
                </div>
              </>
            ) : (
              <>
                <div class="next__head n-mono">
                  <span class="next__badge">Próximo evento</span>
                </div>
                <h3 id="log-next-title" class="next__title">
                  Nuevos eventos muy pronto
                </h3>
                <p class="next__note">
                  Únete a la comunidad y te avisamos del próximo por correo.
                </p>
                <div class="next__actions">
                  <NButton href={communityUrl}>Únete a la comunidad</NButton>
                </div>
              </>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .log {
    padding-block: var(--section-gap);
  }

  .log__body {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: start;
  }

  /* ---- the logbook ---- */
  .log__year + .log__year {
    margin-top: 2.25rem;
  }

  .log__year-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.5rem;
    color: var(--ochre);
    font-size: var(--step-small);
    font-weight: 400;
  }

  .log__year-label::after {
    height: 1px;
    flex: 1;
    background: var(--line);
    content: "";
  }

  .log__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .log__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 1.25rem;
    padding: 0.7rem;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .log__row:hover,
  .log__row:focus-visible {
    background: var(--surface-1);
  }

  .log__thumb {
    display: grid;
    aspect-ratio: 1;
    overflow: hidden;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .log__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .log__row:hover .log__thumb img {
    transform: scale(1.06);
  }

  .log__text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.35rem;
  }

  .log__name {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .log__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.1rem;
    color: var(--muted);
  }

  .log__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .log__dot {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    border-radius: 50%;
    background: var(--muted);
  }

  .log__dot--devfest {
    background: var(--g-blue);
  }
  .log__dot--io,
  .log__dot--studyjam {
    background: var(--g-green);
  }
  .log__dot--wtm {
    background: var(--g-red);
  }
  .log__dot--meetup {
    background: var(--g-yellow);
  }

  .log__next {
    color: var(--ochre);
  }

  .log__go {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    transition:
      color 160ms ease,
      background-color 160ms ease,
      transform 220ms var(--ease-out);
  }

  .log__row:hover .log__go,
  .log__row:focus-visible .log__go {
    background: var(--surface-3);
    color: var(--ochre);
    transform: translateX(3px);
  }

  /* ---- the next event, pinned ---- */
  .log__aside {
    position: sticky;
    top: 5.5rem;
  }

  .next {
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem);
  }

  .next__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .next__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ochre);
  }

  .next__badge::before {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ochre);
    content: "";
    animation: next-pulse 2.4s ease-in-out infinite;
  }

  .next__count {
    color: var(--muted);
  }

  /* The whole poster, never cropped, on a plate behind it. */
  .next__plate {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .next__plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 600ms var(--ease-out);
  }

  .next__plate:hover img {
    transform: scale(1.03);
  }

  .next__title {
    margin: 1.1rem 0 0;
    font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .next__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 1rem 0 0;
    padding: 1rem 0;
    border-block: 1px solid var(--line);
  }

  .next__facts dt {
    color: var(--muted);
  }

  .next__facts dd {
    margin: 0.15rem 0 0;
    color: var(--ink);
  }

  .next__note {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .next__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  @keyframes next-pulse {
    50% {
      opacity: 0.3;
    }
  }

  @media (max-width: 1023px) {
    .log__body {
      grid-template-columns: 1fr;
    }

    /* On narrower screens the next event leads, above the logbook. */
    .log__aside {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .log__row {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 0.9rem;
      padding-inline: 0.25rem;
    }

    .log__go {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next__badge::before {
      animation: none;
    }

    .log__thumb img,
    .next__plate img,
    .log__go {
      transition: none;
    }
  }
</style>

<script>
  /** "Faltan 14 días" next to the badge, in the visitor's own time. */
  document.addEventListener("astro:page-load", () => {
    const el = document.querySelector<HTMLElement>("[data-next-countdown]");
    const iso = el?.dataset.nextCountdown;
    if (!el || !iso) return;
    const start = new Date(iso);
    const day = (d: Date) =>
      Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86_400_000;
    const days = day(start) - day(new Date());
    if (days > 1) el.textContent = `Faltan ${days} días`;
    else if (days === 1) el.textContent = "Es mañana";
    else if (days === 0) el.textContent = "Es hoy";
  });
</script>
