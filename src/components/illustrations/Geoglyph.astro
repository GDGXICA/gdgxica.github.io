---
import { geoglyphs, type GeoglyphName } from "./geoglyphs";

interface Props {
  name: GeoglyphName;
  title?: string;
  class?: string;
  strokeWidth?: number;
  draw?: "load" | "view";
}

const { name, title, class: className, strokeWidth = 5, draw } = Astro.props;
const glyph = geoglyphs[name];
---

<svg
  viewBox="0 0 200 200"
  class:list={[
    className,
    draw === "load" && "glyph-draw",
    draw === "view" && "glyph-draw-on-view",
  ]}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  focusable="false"
>
  {title && <title>{title}</title>}
  <path
    class="glyph-line"
    d={glyph.d}
    pathLength="1"
    stroke="currentColor"
    stroke-width={strokeWidth}></path>
</svg>
