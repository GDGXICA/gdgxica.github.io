---
import { Globe } from "@lucide/astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import TwitterIcon from "./icons/TwitterIcon.astro";
import Tag from "./Tag.astro";

const { organizer } = Astro.props;
---

<div
  class="group flex flex-col gap-3 rounded-lg border border-gray-200 bg-white p-4 transition-all hover:shadow-md sm:gap-4 sm:p-6"
>
  <img
    src={organizer.avatar}
    alt={organizer.name}
    width={96}
    height={96}
    class="mx-auto h-24 w-24 rounded-sm object-cover sm:h-32 sm:w-32"
    loading="lazy"
  />
  <h3 class="text-primary text-center text-lg font-semibold sm:text-2xl">
    {organizer.name}
  </h3>
  <p
    class="text-google-blue mx-auto text-center text-xs font-medium sm:text-sm"
  >
    {organizer.role}
  </p>
  <p class="text-secondary line-clamp-2 text-center text-xs sm:text-sm">
    {organizer.bio}
  </p>
  <div class="hidden flex-wrap justify-center gap-2 sm:flex">
    {organizer.tags.map((tag: string) => <Tag label={tag} />)}
  </div>
  <div class="text-secondary mt-auto flex justify-center gap-2 sm:gap-3">
    {
      organizer.links.linkedin && (
        <a
          href={organizer.links.linkedin}
          aria-label="LinkedIn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <LinkedinIcon size={18} class="hover:text-google-blue" />
        </a>
      )
    }
    {
      organizer.links.twitter && (
        <a
          href={organizer.links.twitter}
          aria-label="Twitter"
          target="_blank"
          rel="noopener noreferrer"
        >
          <TwitterIcon size={18} class="hover:text-google-blue" />
        </a>
      )
    }
    {
      organizer.links.github && (
        <a
          href={organizer.links.github}
          aria-label="GitHub"
          target="_blank"
          rel="noopener noreferrer"
        >
          <GithubIcon size={18} class="hover:text-google-blue" />
        </a>
      )
    }
    {
      organizer.links.web && (
        <a
          href={organizer.links.web}
          aria-label="Website"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Globe size={18} class="hover:text-google-blue" />
        </a>
      )
    }
  </div>
</div>
