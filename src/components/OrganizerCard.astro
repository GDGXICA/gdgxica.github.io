---
/**
 * One person of the team, as an entry in the about page's roster: a round
 * photo beside the name, the role in the community, a line on what they do
 * and their profiles. Used for organizers and members alike.
 */
import { Globe } from "@lucide/astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import TwitterIcon from "./icons/TwitterIcon.astro";
import Tag from "./Tag.astro";

interface Person {
  name: string;
  role: string;
  bio: string;
  avatar: string;
  tags: string[];
  links: {
    linkedin?: string;
    twitter?: string;
    github?: string;
    web?: string;
  };
}

interface Props {
  organizer: Person;
}

const { organizer } = Astro.props;

const profiles = [
  { href: organizer.links.linkedin, label: "LinkedIn", Icon: LinkedinIcon },
  { href: organizer.links.twitter, label: "Twitter", Icon: TwitterIcon },
  { href: organizer.links.github, label: "GitHub", Icon: GithubIcon },
  { href: organizer.links.web, label: "Sitio web", Icon: Globe },
].filter((profile) => Boolean(profile.href));
---

<div class="person">
  <img
    class="person__photo"
    src={organizer.avatar}
    alt={organizer.name}
    width={96}
    height={96}
    loading="lazy"
    decoding="async"
  />
  <div class="person__text">
    <h4 class="person__name">{organizer.name}</h4>
    <p class="person__role">{organizer.role}</p>
    {organizer.bio && <p class="person__bio">{organizer.bio}</p>}
    {
      organizer.tags.length > 0 && (
        <div class="person__tags">
          {organizer.tags.map((tag) => (
            <Tag label={tag} />
          ))}
        </div>
      )
    }
    {
      profiles.length > 0 && (
        <ul class="person__links">
          {profiles.map(({ href, label, Icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${label} de ${organizer.name}`}
                title={label}
              >
                <Icon size={18} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  .person {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
    padding-block: 1.5rem 1.25rem;
  }

  /* A round crop with a fine ring around it, like a survey target. */
  .person__photo {
    width: clamp(4.75rem, 4rem + 1.5vw, 6rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface-2);
    object-fit: cover;
    object-position: 50% 30%;
    outline: 1px solid var(--line-strong);
    outline-offset: 3px;
  }

  .person__name {
    margin: 0.2rem 0 0;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .person__role {
    margin: 0.3rem 0 0;
    color: var(--ink);
    font-size: var(--step-small);
    font-weight: 500;
  }

  .person__bio {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: var(--step-small);
    line-height: 1.45;
  }

  .person__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  /* Full-size touch targets, pulled left so the first icon lines up with
     the text above it. */
  .person__links {
    display: flex;
    flex-wrap: wrap;
    margin: 0.5rem 0 0 -0.8rem;
    padding: 0;
    list-style: none;
  }

  .person__links a {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .person__links a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .person__links a {
      transition: none;
    }
  }
</style>
