---
/**
 * A small label: an event's category or status, or a technology. Categories
 * and statuses carry a coloured dot (Google colours as codes, ochre for what
 * is upcoming); a highlighted tag is filled with ochre.
 */
import { Star } from "@lucide/astro";
import { dotColor } from "@/lib/categories";

interface Props {
  label: string;
  type?: string;
  isHighLight?: boolean;
}

const { label, type, isHighLight } = Astro.props;
const dot = dotColor(type);
---

{
  isHighLight ? (
    <span class="tag tag--hl">
      <Star size={13} stroke-width={2.2} aria-hidden="true" />
      {label}
    </span>
  ) : (
    <span class="tag" style={dot ? `--dot: ${dot}` : undefined}>
      {dot && <span class="tag__dot" aria-hidden="true" />}
      {label}
    </span>
  )
}

<style>
  .tag {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: rgb(7 11 22 / 0.72);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .tag__dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--dot);
  }

  .tag--hl {
    border-color: transparent;
    background: var(--ochre);
    color: var(--ochre-ink);
    font-weight: 600;
  }
</style>
