---
import { Star } from "@lucide/astro";
import { cn } from "@/utils/cn";

const typeStyles = {
  devfest: "bg-sign-blue text-white",
  io: "bg-sign-blue text-white",
  studyjam: "bg-sign-green text-white",
  wtm: "bg-sign-green text-white",
  meetup: "bg-sign-yellow text-ink",
  hackaton: "bg-ink text-white",
  upcoming: "bg-sign-green text-white",
  "in-progress": "bg-sign-blue text-white",
  completed: "bg-sign-white text-ink",
} as const;
type Type = keyof typeof typeStyles;

const { label, type, isHighLight } = Astro.props;
const base =
  "inline-flex items-center gap-1 rounded-[6px] border-2 border-ink px-2 pt-[3px] pb-px text-xs font-extrabold";
---

{
  isHighLight ? (
    <span class={cn(base, "bg-sign-yellow text-ink tracking-wide uppercase")}>
      <Star size={13} stroke-width={2.5} aria-hidden="true" />
      {label}
    </span>
  ) : type ? (
    <span
      class={cn(
        base,
        "tracking-wide uppercase",
        typeStyles[type as Type] ?? "bg-sign-white text-ink"
      )}
    >
      {label}
    </span>
  ) : (
    <span class={cn(base, "bg-sign-white text-ink border-line")}>{label}</span>
  )
}
