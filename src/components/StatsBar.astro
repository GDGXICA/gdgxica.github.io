---
interface StatItem {
  value: string;
  label: string;
  color?: string;
}

interface Props {
  stats: StatItem[];
}

const { stats } = Astro.props;
---

<dl
  class="plate bg-sign-white divide-ink grid grid-cols-2 md:flex md:divide-x-[3px]"
>
  {
    stats.map((stat) => (
      <div class="flex flex-col-reverse gap-1 px-6 py-4 md:flex-1">
        <dt class="text-ink-muted text-sm font-bold">{stat.label}</dt>
        <dd class="text-ink text-[2rem] leading-none font-black tabular-nums">
          {stat.value}
        </dd>
      </div>
    ))
  }
</dl>
