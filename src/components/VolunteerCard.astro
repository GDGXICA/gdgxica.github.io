---
/**
 * A volunteer, as an entry in the volunteers roster: a round photo beside
 * the name, the role, the area they support, a short bio and profiles. Same
 * shape as a team entry on the about page.
 */
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import TwitterIcon from "./icons/TwitterIcon.astro";
import Tag from "./Tag.astro";

interface Volunteer {
  name: string;
  role: string;
  area: string;
  bio: string;
  avatar: string;
  links: {
    linkedin?: string;
    github?: string;
    twitter?: string;
  };
}

interface Props {
  volunteer: Volunteer;
}

const { volunteer } = Astro.props;

const profiles = [
  { href: volunteer.links.linkedin, label: "LinkedIn", Icon: LinkedinIcon },
  { href: volunteer.links.github, label: "GitHub", Icon: GithubIcon },
  { href: volunteer.links.twitter, label: "Twitter", Icon: TwitterIcon },
].filter((profile) => Boolean(profile.href));
---

<div class="volunteer" data-area={volunteer.area}>
  <img
    class="volunteer__photo"
    src={volunteer.avatar || "/placeholder.svg"}
    alt={volunteer.name}
    width={96}
    height={96}
    loading="lazy"
    decoding="async"
  />
  <div class="volunteer__text">
    <h3 class="volunteer__name">{volunteer.name}</h3>
    <p class="volunteer__role">{volunteer.role}</p>
    {
      volunteer.area && (
        <p class="volunteer__area">
          <Tag label={volunteer.area} />
        </p>
      )
    }
    {volunteer.bio && <p class="volunteer__bio">{volunteer.bio}</p>}
    {
      profiles.length > 0 && (
        <ul class="volunteer__links">
          {profiles.map(({ href, label, Icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${label} de ${volunteer.name}`}
                title={label}
              >
                <Icon size={18} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  .volunteer {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
    padding-block: 1.5rem 1.25rem;
  }

  .volunteer__photo {
    width: clamp(4.75rem, 4rem + 1.5vw, 6rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface-2);
    object-fit: cover;
    object-position: 50% 30%;
    outline: 1px solid var(--line-strong);
    outline-offset: 3px;
  }

  .volunteer__name {
    margin: 0.2rem 0 0;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .volunteer__role {
    margin: 0.3rem 0 0;
    color: var(--ink);
    font-size: var(--step-small);
    font-weight: 500;
  }

  .volunteer__area {
    margin: 0.6rem 0 0;
  }

  .volunteer__bio {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: var(--step-small);
    line-height: 1.5;
  }

  /* Full-size touch targets, pulled left so the first icon lines up with
     the text above it. */
  .volunteer__links {
    display: flex;
    flex-wrap: wrap;
    margin: 0.5rem 0 0 -0.8rem;
    padding: 0;
    list-style: none;
  }

  .volunteer__links a {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .volunteer__links a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .volunteer__links a {
      transition: none;
    }
  }
</style>
