---
import { Menu } from "@lucide/astro";

const data = {
  logo: {
    image: "/gdg-logo.png",
    imageAlt: "Logo del GDG ICA",
    name: "GDG ICA",
    description: "Google Developer Group Ica",
  },
  links: [
    {
      id: 1,
      text: "Nosotros",
      url: "/about",
      target: "_self",
    },
    {
      id: 2,
      text: "Eventos",
      url: "/events",
      target: "_self",
    },
    {
      id: 3,
      text: "Voluntariado",
      url: "/volunteers",
      target: "_self",
    },
    {
      id: 4,
      text: "Foro",
      url: "/foro",
      target: "_self",
    },
    {
      id: 5,
      text: "Patrocinadores",
      url: "/sponsors",
      target: "_self",
    },
  ],
};
---

<header class="border-gray-custom border-b bg-white py-4">
  <div class="mx-auto max-w-[1400px] px-4">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 min-[1360px]:basis-1/3">
        <img
          src={data.logo.image}
          class="h-[40px] w-[40px] min-[1360px]:h-[64px] min-[1360px]:w-[64px]"
          width={64}
          height={64}
          alt={data.logo.imageAlt}
        />
        <div>
          <p class="text-primary text-lg font-bold">{data.logo.name}</p>
          <p class="text-secondary text-xs">{data.logo.description}</p>
        </div>
      </a>
      <nav
        id="navigation"
        aria-label="Navegación principal"
        class="fixed inset-0 top-[77px] z-10 flex grow translate-x-full flex-col justify-start gap-6 bg-white px-4 py-10 min-[1360px]:static min-[1360px]:translate-0 min-[1360px]:flex-row min-[1360px]:items-center min-[1360px]:justify-end min-[1360px]:py-0 md:gap-0"
      >
        <ul class="flex flex-col gap-6 min-[1360px]:flex-row">
          {
            data.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target={link.target}
                  class="text-secondary text-base font-medium"
                  aria-label={`Enlace a ${link.text}`}
                >
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        id="hamburgerButton"
        class="min-[1360px]:hidden"
        aria-label="Abrir menú"
      >
        <Menu stroke-width={1.5} />
      </button>
    </div>
  </div>
</header>
<script is:inline>
  function initMenu() {
    const menuButton = document.querySelector("#hamburgerButton");
    const menuNavigation = document.querySelector("#navigation");

    if (!menuButton || !menuNavigation) return;

    const animateMenuChange = () => {
      menuNavigation.classList.add("transition-transform");
      menuNavigation.addEventListener(
        "transitionend",
        () => menuNavigation.classList.remove("transition-transform"),
        { once: true }
      );
    };

    // Toggle menú
    menuButton.onclick = () => {
      if (window.matchMedia("(min-width: 1360px)").matches) return;
      animateMenuChange();
      menuNavigation.classList.toggle("translate-x-full");
    };

    // Cerrar menú al hacer click en un link
    menuNavigation.querySelectorAll("a").forEach((link) => {
      link.onclick = () => {
        if (!window.matchMedia("(min-width: 1360px)").matches) {
          animateMenuChange();
        }
        menuNavigation.classList.add("translate-x-full");
      };
    });
  }

  // Ejecutar al cargar
  initMenu();

  // Ejecutar después de cada transición de página
  document.addEventListener("astro:after-swap", initMenu);
</script>
