---
import { Menu, X } from "@lucide/astro";
import { getCollection } from "astro:content";
import { fetchLinks } from "@/loaders/transform-site-config";
import { getNextEvent } from "@/utils/events";

const links = [
  { text: "Eventos", url: "/events" },
  { text: "Nosotros", url: "/about" },
  { text: "Voluntariado", url: "/volunteers" },
  { text: "Foro", url: "/foro" },
  { text: "Patrocinadores", url: "/sponsors" },
];

const siteLinks = await fetchLinks();
const nextEvent = getNextEvent(await getCollection("events"));
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isCurrent = (url: string) =>
  pathname === url || pathname.startsWith(`${url}/`);

const cta = nextEvent?.data.registerFormLink
  ? {
      text: "Inscríbete",
      href: nextEvent.data.registerFormLink,
      tone: "bg-sign-blue hover:bg-sign-blue-deep",
    }
  : {
      text: "Únete",
      href: siteLinks.community,
      tone: "bg-sign-green hover:bg-sign-green-deep",
    };
---

<header class="relative z-30" data-site-header>
  <div
    class="max-w-site mx-auto flex items-center gap-4 px-4 py-4 md:px-8 lg:py-6"
  >
    <a
      href="/"
      class="plate bg-sign-white mr-auto flex items-center gap-3 py-1.5 pr-4 pl-2"
    >
      <img src="/gdg-logo.png" width={36} height={36} alt="" class="h-9 w-9" />
      <span class="flex flex-col leading-none">
        <span class="text-ink text-xl font-black tracking-tight">GDG ICA</span>
        <span class="text-ink-muted mt-1 text-[0.6875rem] font-bold">
          Google Developer Group
        </span>
      </span>
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.url}
                aria-current={isCurrent(link.url) ? "page" : undefined}
                class="group bg-ink hover:bg-sign-green aria-[current=page]:bg-sign-green rounded-plate block p-[3px] text-white transition-colors"
              >
                <span class="block rounded-[7px] border-2 border-white px-3 pt-1.5 pb-1 text-[0.9375rem] font-extrabold">
                  {link.text}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      !isHome && (
        <a
          href={cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class={`${cta.tone} rounded-plate hidden p-[3px] text-white transition-colors sm:block`}
        >
          <span class="block rounded-[7px] border-2 border-white px-4 pt-1.5 pb-1 text-[0.9375rem] font-black">
            {cta.text}
          </span>
        </a>
      )
    }

    <button
      type="button"
      class="bg-ink rounded-plate inline-flex items-center gap-2 p-[3px] text-white lg:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      data-menu-button
    >
      <span
        class="flex items-center gap-2 rounded-[7px] border-2 border-white px-3 py-1.5 text-[0.9375rem] font-extrabold"
      >
        <Menu size={18} stroke-width={2.25} data-menu-open />
        <X size={18} stroke-width={2.25} class="hidden" data-menu-close />
        Menú
      </span>
    </button>
  </div>

  <nav
    id="menu-movil"
    aria-label="Navegación principal"
    class="border-ink bg-sand hidden border-y-[3px] lg:hidden"
    data-menu-panel
  >
    <ul class="max-w-site mx-auto flex flex-col gap-2 px-4 py-4 md:px-8">
      {
        links.map((link) => (
          <li>
            <a
              href={link.url}
              aria-current={isCurrent(link.url) ? "page" : undefined}
              class="bg-ink aria-[current=page]:bg-sign-green rounded-plate block p-[3px] text-white"
            >
              <span class="block rounded-[7px] border-2 border-white px-4 pt-3 pb-2.5 text-lg font-extrabold">
                {link.text}
              </span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class={`${cta.tone} block rounded-plate p-[3px] text-white`}
        >
          <span
            class="block rounded-[7px] border-2 border-white px-4 pt-3 pb-2.5 text-lg font-black"
          >
            {cta.text}
          </span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  function initMenu() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const button =
      header?.querySelector<HTMLButtonElement>("[data-menu-button]");
    const panel = header?.querySelector<HTMLElement>("[data-menu-panel]");
    if (!header || !button || !panel) return;

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("hidden", !open);
      button
        .querySelector("[data-menu-open]")
        ?.classList.toggle("hidden", open);
      button
        .querySelector("[data-menu-close]")
        ?.classList.toggle("hidden", !open);
    };

    button.addEventListener("click", () =>
      setOpen(button.getAttribute("aria-expanded") !== "true")
    );

    header.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (button.getAttribute("aria-expanded") !== "true") return;
      setOpen(false);
      button.focus();
    });

    panel
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));
  }

  document.addEventListener("astro:page-load", initMenu);
</script>
