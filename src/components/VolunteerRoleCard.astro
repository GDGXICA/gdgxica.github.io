---
/**
 * One way to volunteer, as a row of the roles list: its number, the role,
 * what it involves, the skills it asks for and the time it takes.
 */
import { Clock } from "@lucide/astro";
import Tag from "./Tag.astro";

interface Props {
  title: string;
  description: string;
  skills: string[];
  commitment?: string;
  /** Position in the list, shown as the row's number. */
  index?: number;
  /** Kept in the data for the old cards; the row draws no icon. */
  icon?: string;
  iconColor?: string;
}

const { title, description, skills, commitment, index } = Astro.props;
---

<article class="role">
  {
    index !== undefined && (
      <span class="role__index n-mono" aria-hidden="true">
        {String(index).padStart(2, "0")}
      </span>
    )
  }
  <div class="role__head">
    <h3 class="role__title">{title}</h3>
    {
      commitment && (
        <p class="role__time n-mono">
          <Clock size={15} stroke-width={2} aria-hidden="true" />
          {commitment}
        </p>
      )
    }
  </div>
  <p class="role__desc">{description}</p>
  {
    skills.length > 0 && (
      <div class="role__skills">
        <span class="role__skills-label">Habilidades</span>
        <ul>
          {skills.map((skill) => (
            <li>
              <Tag label={skill} />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .role {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-block: clamp(1.4rem, 1rem + 1vw, 2rem);
  }

  .role > :not(.role__index) {
    grid-column: 2;
  }

  .role__index {
    grid-row: 1;
    padding-top: 0.35em;
    color: var(--ochre);
  }

  .role__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
  }

  .role__title {
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .role__time {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--muted);
  }

  .role__time :global(svg) {
    flex: none;
    color: var(--ochre);
  }

  .role__desc {
    max-width: 56ch;
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  .role__skills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1rem;
  }

  .role__skills-label {
    color: var(--muted);
    font-size: var(--step-small);
  }

  .role__skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 479px) {
    .role {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      column-gap: 0.5rem;
    }
  }
</style>
