---
/**
 * A multi-track agenda: one tab per track (auditorium, lab…) and the
 * track's sessions as a timeline below. Tabs follow the WAI-ARIA tabs
 * pattern: arrow keys, Home and End move between them, and only the active
 * tab sits in the tab order. The first track is shown without JavaScript.
 */
import ScheduleCard from "@/components/ScheduleCard.astro";

interface Track {
  id: string;
  name: string;
  color: string;
  description: string;
}

interface Session {
  id: number;
  title: string;
  name: string;
  image: string;
  role: string;
  type: string;
  startTime: string;
  endTime: string;
  duration: string;
  isKeynote?: boolean;
}

interface Schedule {
  trackSessions: Record<string, Session[]>;
}

interface Props {
  schedule: Schedule;
  tracks: Track[];
}

const { schedule, tracks } = Astro.props;
const trackSessions = schedule.trackSessions;
---

<div class="tracks" data-tracks>
  <div class="tracks__scroll">
    <div class="tracks__list" role="tablist" aria-label="Tracks de la agenda">
      {
        tracks.map((track, index) => (
          <button
            type="button"
            role="tab"
            class="tracks__tab"
            id={`track-tab-${track.id}`}
            aria-controls={`track-content-${track.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
          >
            <span
              class="tracks__dot"
              style={`--dot: ${track.color}`}
              aria-hidden="true"
            />
            {track.name}
          </button>
        ))
      }
    </div>
  </div>

  {
    tracks.map((track, index) => (
      <div
        class="tracks__panel"
        role="tabpanel"
        id={`track-content-${track.id}`}
        aria-labelledby={`track-tab-${track.id}`}
        tabindex="0"
        hidden={index !== 0}
      >
        {track.description && <p class="tracks__desc">{track.description}</p>}
        <ol class="tracks__timeline">
          {trackSessions[track.id]?.map((session) => (
            <ScheduleCard {...session} showType />
          ))}
        </ol>
      </div>
    ))
  }
</div>

<style>
  .tracks__scroll {
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    scrollbar-width: thin;
  }

  .tracks__list {
    display: flex;
    min-width: max-content;
    gap: 0.25rem;
  }

  .tracks__tab {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem;
    border: 0;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .tracks__tab:hover {
    background: var(--surface-1);
    color: var(--ink);
  }

  /* Inside a scroller an outset ring would be clipped. */
  .tracks__tab:focus-visible {
    outline-offset: -2px;
  }

  /* The active track: ink, and an ochre rule standing on the baseline. */
  .tracks__tab::after {
    position: absolute;
    right: 0.5rem;
    bottom: -1px;
    left: 0.5rem;
    height: 2px;
    background: var(--ochre);
    content: "";
    transform: scaleX(0);
    transition: transform 220ms var(--ease-out);
  }

  .tracks__tab[aria-selected="true"] {
    color: var(--ink);
  }

  .tracks__tab[aria-selected="true"]::after {
    transform: scaleX(1);
  }

  .tracks__dot {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    border-radius: 50%;
    background: var(--dot);
  }

  .tracks__panel {
    padding-top: 1.25rem;
    animation: tracks-in 260ms var(--ease-out);
  }

  .tracks__panel:focus-visible {
    outline-offset: 6px;
  }

  .tracks__desc {
    margin: 0 0 0.75rem;
    color: var(--muted);
  }

  .tracks__timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @keyframes tracks-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tracks__panel {
      animation: none;
    }

    .tracks__tab,
    .tracks__tab::after {
      transition: none;
    }
  }
</style>

<script>
  function initTracks(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const select = (active: HTMLButtonElement, focus: boolean) => {
      tabs.forEach((tab) => {
        const on = tab === active;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(
          tab.getAttribute("aria-controls") ?? ""
        );
        if (panel) panel.hidden = !on;
      });
      if (focus) {
        active.focus();
        active.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight"
            ? index === last
              ? 0
              : index + 1
            : event.key === "ArrowLeft"
              ? index === 0
                ? last
                : index - 1
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? last
                  : -1;
        if (next < 0) return;
        event.preventDefault();
        select(tabs[next], true);
      });
    });
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-tracks]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";
      initTracks(root);
    });
  });
</script>
