---
// Minimal full-screen layout for the venue projector & mural views.
// Pure #000000 background locked in for maximum legibility on auditorium
// screens, while inheriting the GDG ICA typography (Chakra Petch,
// Bricolage Grotesque, Geist Mono) and brand tokens.
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="stage-black min-h-screen bg-black text-[#ecebe2]">
    <slot />
  </body>
</html>
